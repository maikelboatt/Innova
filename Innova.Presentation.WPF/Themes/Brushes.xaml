<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        ══════════════════════════════════════════════════════════════════
        MediCore Brush Library
        Converts every Color into a SolidColorBrush for XAML binding.
        
        Usage in XAML:
        Background="{StaticResource PrimaryBlue600Brush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        BorderBrush="{StaticResource BorderDefaultBrush}"
        ══════════════════════════════════════════════════════════════════
    -->

    <!--  ── Pure anchors ───────────────────────────────────────────  -->
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource Transparent}" />

    <!--  ── Surface brushes ────────────────────────────────────────  -->
    <!--
        Surface0 = page canvas (darkest surface, sidebar)
        Surface1 = content background
        Surface2 = card / panel
        Surface3 = popover / dialog
    -->
    <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource NeutralGray900}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource NeutralGray100}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource White}" />

    <!--  ── Sidebar surface ────────────────────────────────────────  -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource NeutralGray900}" />
    <SolidColorBrush x:Key="SidebarNavItemHoverBrush" Color="{StaticResource NeutralGray800}" />
    <SolidColorBrush x:Key="SidebarNavItemActiveBrush" Color="{StaticResource PrimaryBlue800}" />
    <SolidColorBrush x:Key="SidebarIconBrush" Color="{StaticResource NeutralGray300}" />
    <SolidColorBrush x:Key="SidebarIconActiveBrush" Color="{StaticResource PrimaryBlue200}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource NeutralGray200}" />
    <SolidColorBrush x:Key="SidebarTextActiveBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="{StaticResource NeutralGray800}" />

    <!--  ── Text brushes ───────────────────────────────────────────  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource NeutralGray900}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource NeutralGray600}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource NeutralGray400}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource NeutralGray300}" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="TextAccentBrush" Color="{StaticResource PrimaryBlue600}" />
    <SolidColorBrush x:Key="TextDangerBrush" Color="{StaticResource DangerRed600}" />
    <SolidColorBrush x:Key="TextSuccessBrush" Color="{StaticResource SuccessGreen600}" />
    <SolidColorBrush x:Key="TextWarningBrush" Color="{StaticResource WarningAmber600}" />

    <!--  ── Border brushes ─────────────────────────────────────────  -->
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource NeutralGray200}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource NeutralGray300}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource PrimaryBlue400}" />
    <SolidColorBrush x:Key="BorderDangerBrush" Color="{StaticResource DangerRed400}" />
    <SolidColorBrush x:Key="BorderSuccessBrush" Color="{StaticResource SuccessGreen400}" />

    <!--  ── PrimaryBlue brushes ────────────────────────────────────  -->
    <SolidColorBrush x:Key="PrimaryBlue50Brush" Color="{StaticResource PrimaryBlue50}" />
    <SolidColorBrush x:Key="PrimaryBlue100Brush" Color="{StaticResource PrimaryBlue100}" />
    <SolidColorBrush x:Key="PrimaryBlue200Brush" Color="{StaticResource PrimaryBlue200}" />
    <SolidColorBrush x:Key="PrimaryBlue400Brush" Color="{StaticResource PrimaryBlue400}" />
    <SolidColorBrush x:Key="PrimaryBlue600Brush" Color="{StaticResource PrimaryBlue600}" />
    <SolidColorBrush x:Key="PrimaryBlue800Brush" Color="{StaticResource PrimaryBlue800}" />
    <SolidColorBrush x:Key="PrimaryBlue900Brush" Color="{StaticResource PrimaryBlue900}" />

    <!--  ── ClinicalTeal brushes ───────────────────────────────────  -->
    <SolidColorBrush x:Key="ClinicalTeal50Brush" Color="{StaticResource ClinicalTeal50}" />
    <SolidColorBrush x:Key="ClinicalTeal100Brush" Color="{StaticResource ClinicalTeal100}" />
    <SolidColorBrush x:Key="ClinicalTeal400Brush" Color="{StaticResource ClinicalTeal400}" />
    <SolidColorBrush x:Key="ClinicalTeal600Brush" Color="{StaticResource ClinicalTeal600}" />

    <!--  ── SuccessGreen brushes ───────────────────────────────────  -->
    <SolidColorBrush x:Key="SuccessGreen50Brush" Color="{StaticResource SuccessGreen50}" />
    <SolidColorBrush x:Key="SuccessGreen100Brush" Color="{StaticResource SuccessGreen100}" />
    <SolidColorBrush x:Key="SuccessGreen400Brush" Color="{StaticResource SuccessGreen400}" />
    <SolidColorBrush x:Key="SuccessGreen600Brush" Color="{StaticResource SuccessGreen600}" />
    <SolidColorBrush x:Key="SuccessGreen800Brush" Color="{StaticResource SuccessGreen800}" />


    <!--  ── WarningAmber brushes ───────────────────────────────────  -->
    <SolidColorBrush x:Key="WarningAmber50Brush" Color="{StaticResource WarningAmber50}" />
    <SolidColorBrush x:Key="WarningAmber100Brush" Color="{StaticResource WarningAmber100}" />
    <SolidColorBrush x:Key="WarningAmber400Brush" Color="{StaticResource WarningAmber400}" />
    <SolidColorBrush x:Key="WarningAmber600Brush" Color="{StaticResource WarningAmber600}" />

    <!--  ── DangerRed brushes ──────────────────────────────────────  -->
    <SolidColorBrush x:Key="DangerRed50Brush" Color="{StaticResource DangerRed50}" />
    <SolidColorBrush x:Key="DangerRed100Brush" Color="{StaticResource DangerRed100}" />
    <SolidColorBrush x:Key="DangerRed400Brush" Color="{StaticResource DangerRed400}" />
    <SolidColorBrush x:Key="DangerRed600Brush" Color="{StaticResource DangerRed600}" />

    <!--  ── NeutralGray brushes ────────────────────────────────────  -->
    <SolidColorBrush x:Key="NeutralGray50Brush" Color="{StaticResource NeutralGray50}" />
    <SolidColorBrush x:Key="NeutralGray100Brush" Color="{StaticResource NeutralGray100}" />
    <SolidColorBrush x:Key="NeutralGray200Brush" Color="{StaticResource NeutralGray200}" />
    <SolidColorBrush x:Key="NeutralGray300Brush" Color="{StaticResource NeutralGray300}" />
    <SolidColorBrush x:Key="NeutralGray400Brush" Color="{StaticResource NeutralGray400}" />
    <SolidColorBrush x:Key="NeutralGray500Brush" Color="{StaticResource NeutralGray500}" />
    <SolidColorBrush x:Key="NeutralGray600Brush" Color="{StaticResource NeutralGray600}" />
    <SolidColorBrush x:Key="NeutralGray700Brush" Color="{StaticResource NeutralGray700}" />
    <SolidColorBrush x:Key="NeutralGray800Brush" Color="{StaticResource NeutralGray800}" />
    <SolidColorBrush x:Key="NeutralGray900Brush" Color="{StaticResource NeutralGray900}" />

    <!--  ── Status badge brushes ───────────────────────────────────  -->
    <SolidColorBrush x:Key="StatusActiveFillBrush" Color="{StaticResource StatusActiveFill}" />
    <SolidColorBrush x:Key="StatusActiveTextBrush" Color="{StaticResource StatusActiveText}" />
    <SolidColorBrush x:Key="StatusActiveBorderBrush" Color="{StaticResource StatusActiveBorder}" />

    <SolidColorBrush x:Key="StatusSuccessFillBrush" Color="{StaticResource StatusSuccessFill}" />
    <SolidColorBrush x:Key="StatusSuccessTextBrush" Color="{StaticResource StatusSuccessText}" />
    <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="{StaticResource StatusSuccessBorder}" />

    <SolidColorBrush x:Key="StatusDangerFillBrush" Color="{StaticResource StatusDangerFill}" />
    <SolidColorBrush x:Key="StatusDangerTextBrush" Color="{StaticResource StatusDangerText}" />
    <SolidColorBrush x:Key="StatusDangerBorderBrush" Color="{StaticResource StatusDangerBorder}" />

    <SolidColorBrush x:Key="StatusWarningFillBrush" Color="{StaticResource StatusWarningFill}" />
    <SolidColorBrush x:Key="StatusWarningTextBrush" Color="{StaticResource StatusWarningText}" />
    <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="{StaticResource StatusWarningBorder}" />

    <SolidColorBrush x:Key="StatusClinicalFillBrush" Color="{StaticResource StatusClinicalFill}" />
    <SolidColorBrush x:Key="StatusClinicalTextBrush" Color="{StaticResource StatusClinicalText}" />
    <SolidColorBrush x:Key="StatusClinicalBorderBrush" Color="{StaticResource StatusClinicalBorder}" />

    <SolidColorBrush x:Key="StatusNeutralFillBrush" Color="{StaticResource StatusNeutralFill}" />
    <SolidColorBrush x:Key="StatusNeutralTextBrush" Color="{StaticResource StatusNeutralText}" />
    <SolidColorBrush x:Key="StatusNeutralBorderBrush" Color="{StaticResource StatusNeutralBorder}" />

    <!--  ── Overlay / scrim ────────────────────────────────────────  -->
    <!--  Used by the dialog overlay behind popup forms  -->
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#B3000000" />

    <!--  ── Card shadow (emulated with border, no drop shadow) ──────  -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource NeutralGray200}" />

    <!--  Light Theme Color Scheme  -->
    <!--  This dictionary provides light theme colors  -->

    <!--  Background Colors  -->
    <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#FFFFFF" />
    <!--  Main background - white  -->
    <SolidColorBrush x:Key="SecondaryBackgroundColor" Color="#F8FAFC" />
    <!--  Sidebar/card background - light gray  -->
    <SolidColorBrush x:Key="TertiaryBackgroundColor" Color="#F1F5F9" />
    <!--  Elevated surfaces  -->

    <!--  Text Colors  -->
    <SolidColorBrush x:Key="PrimaryTextColor" Color="#1E293B" />
    <!--  Main text - dark slate  -->
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#64748B" />
    <!--  Secondary text - gray  -->
    <SolidColorBrush x:Key="TertiaryTextColor" Color="#475569" />
    <!--  Tertiary text  -->
    <SolidColorBrush x:Key="TextFourthColor" Color="#94A3B8" />
    <!--  Dimmed text  -->

    <!--  Border Colors  -->
    <SolidColorBrush x:Key="SecondaryBorderColor" Color="#E2E8F0" />
    <!--  Borders and dividers  -->

    <!--  Info Panel Colors  -->
    <SolidColorBrush x:Key="InfoBackgroundColor" Color="#DBEAFE" />
    <!--  Info panel background  -->
    <SolidColorBrush x:Key="InfoBorderColor" Color="#3B82F6" />
    <!--  Info panel border  -->
    <SolidColorBrush x:Key="InfoIconColor" Color="#2563EB" />
    <!--  Info icon color  -->
    <SolidColorBrush x:Key="InfoTextColor" Color="#1E40AF" />
    <!--  Info text color  -->

    <!--  Button Colors  -->
    <SolidColorBrush x:Key="CreateBtnBackgroundColor" Color="#3B82F6" />
    <!--  Primary blue button  -->
    <SolidColorBrush x:Key="CreateBtnHoverColor" Color="#2563EB" />
    <!--  Button hover  -->
    <SolidColorBrush x:Key="CreateBtnPressedColor" Color="#1D4ED8" />
    <!--  Button pressed  -->

    <SolidColorBrush x:Key="CancelBtnBackgroundColor" Color="#EF4444" />
    <!--  Cancel/Delete button  -->
    <SolidColorBrush x:Key="CancelBtnHoverColor" Color="#DC2626" />
    <!--  Cancel hover  -->
    <SolidColorBrush x:Key="CancelBtnPressedColor" Color="#B91C1C" />
    <!--  Cancel pressed  -->

    <SolidColorBrush x:Key="EditBtnBackgroundColor" Color="#F59E0B" />
    <!--  Edit button  -->
    <SolidColorBrush x:Key="EditBtnHoverColor" Color="#D97706" />
    <!--  Edit hover  -->
    <SolidColorBrush x:Key="EditBtnPressedColor" Color="#B45309" />
    <!--  Edit pressed  -->

    <SolidColorBrush x:Key="DelBtnBackgroundColor" Color="#EF4444" />
    <!--  Delete button  -->
    <SolidColorBrush x:Key="DelBtnHoverColor" Color="#DC2626" />
    <!--  Delete hover  -->
    <SolidColorBrush x:Key="DelBtnPressedColor" Color="#B91C1C" />
    <!--  Delete pressed  -->

    <!--  Blue Colors  -->
    <SolidColorBrush x:Key="PrimaryBlueColor" Color="#004FC4" />
    <!--  Primary brand blue  -->
    <SolidColorBrush x:Key="SecondaryBlueColor" Color="#0063F7" />
    <!--  Brighter blue  -->
    <SolidColorBrush x:Key="TertiaryBlueColor" Color="#5B8DEF" />
    <!--  Light blue  -->

    <!--  Red Colors  -->
    <SolidColorBrush x:Key="PrimaryRedColor" Color="#E63535" />
    <!--  Primary red  -->
    <SolidColorBrush x:Key="SecondaryRedColor" Color="#FF3B3B" />
    <!--  Bright red  -->
    <SolidColorBrush x:Key="TertiaryRedColor" Color="#FF5C5C" />
    <!--  Light red  -->

    <!--  Green Colors  -->
    <SolidColorBrush x:Key="PrimaryGreenColor" Color="#05A660" />
    <!--  Primary green  -->
    <SolidColorBrush x:Key="SecondaryGreenColor" Color="#06C270" />
    <!--  Bright green  -->
    <SolidColorBrush x:Key="TertiaryGreenColor" Color="#39D98A" />
    <!--  Light green  -->

    <!--  Orange Colors  -->
    <SolidColorBrush x:Key="PrimaryOrangeColor" Color="#E67A00" />
    <!--  Primary orange  -->
    <SolidColorBrush x:Key="SecondaryOrangeColor" Color="#FF8800" />
    <!--  Bright orange  -->
    <SolidColorBrush x:Key="TertiaryOrangeColor" Color="#FDAC42" />
    <!--  Light orange  -->

    <!--  Yellow Colors  -->
    <SolidColorBrush x:Key="PrimaryYellowColor" Color="#E6B800" />
    <!--  Primary yellow  -->
    <SolidColorBrush x:Key="SecondaryYellowColor" Color="#FFCC00" />
    <!--  Bright yellow  -->
    <SolidColorBrush x:Key="TertiaryYellowColor" Color="#FDDD48" />
    <!--  Light yellow  -->

    <!--  Teal Colors  -->
    <SolidColorBrush x:Key="PrimaryTealColor" Color="#00B7C4" />
    <!--  Primary teal  -->
    <SolidColorBrush x:Key="SecondaryTealColor" Color="#00CFDE" />
    <!--  Bright teal  -->
    <SolidColorBrush x:Key="TertiaryTealColor" Color="#73DFE7" />
    <!--  Light teal  -->

    <!--  White/Light Colors  -->
    <SolidColorBrush x:Key="PrimaryWhiteColor" Color="#C0C9EA" />
    <!--  Off white with blue tint  -->
    <SolidColorBrush x:Key="SecondaryWhiteColor" Color="#EDF4FF" />
    <!--  Very light blue  -->
    <SolidColorBrush x:Key="TertiaryWhiteColor" Color="#FFFFFF" />
    <!--  Pure white  -->

    <!--  Black/Dark Colors  -->
    <SolidColorBrush x:Key="PrimaryBlackColor" Color="#0E1A32" />
    <!--  Very dark blue  -->
    <SolidColorBrush x:Key="SecondaryBlackColor" Color="#102341" />
    <!--  Dark blue  -->
    <SolidColorBrush x:Key="TertiaryBlackColor" Color="#1C3254" />
    <!--  Medium dark blue  -->

    <!--  TextBox Colors  -->
    <SolidColorBrush x:Key="PrimaryTextBoxBackgroundColor" Color="#FFFFFF" />
    <!--  TextBox background  -->
    <SolidColorBrush x:Key="SecondaryTextBoxGrayColor" Color="#CBD5E1" />
    <!--  TextBox border  -->
    <SolidColorBrush x:Key="PrimaryTextColor2" Color="#1E293B" />
    <!--  TextBox text  -->

    <!--  Icon Colors  -->
    <SolidColorBrush x:Key="IconColor" Color="#64748B" />
    <!--  Icon color  -->

    <!--  Control Colors  -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <!--  Control background  -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
    <!--  Control border  -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1E293B" />
    <!--  Control foreground  -->
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#94A3B8" />
    <!--  Placeholder text  -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <!--  Accent color  -->
    <SolidColorBrush x:Key="IconBrush" Color="#64748B" />
    <!--  Icon brush  -->

    <!--  Card & Panel Colors  -->
    <SolidColorBrush x:Key="CardBackgroundColor" Color="#FFFFFF" />
    <!--  Card background - White  -->
    <SolidColorBrush x:Key="CardBorderColor" Color="#E2E8F0" />
    <!--  Card border - Light gray  -->
    <SolidColorBrush x:Key="ChartPlaceholderBackground" Color="#F8FAFC" />
    <!--  Chart placeholder background  -->

    <!--  Header Colors  -->
    <SolidColorBrush x:Key="PrimaryHeaderColor" Color="#1E293B" />
    <!--  Main headers - Dark slate  -->
    <SolidColorBrush x:Key="SecondaryHeaderColor" Color="#64748B" />

</ResourceDictionary>