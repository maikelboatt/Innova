    <Color x:Key="NeutralGray900">#FF0F172A</Color>

    <!--  ══════════════════════════════════════════════════════════  -->
    <!--  Semantic Status Colors — same mapping as before, re-derived  -->
    <!--  from the scales above.  -->
    <!--  ══════════════════════════════════════════════════════════  -->

    <Color x:Key="StatusActiveFill">#FFEFF6FF</Color>
    <Color x:Key="StatusActiveText">#FF2563EB</Color>
    <Color x:Key="StatusActiveBorder">#FFBFDBFE</Color>

    <Color x:Key="StatusSuccessFill">#FFECFDF5</Color>
    <Color x:Key="StatusSuccessText">#FF059669</Color>
    <Color x:Key="StatusSuccessBorder">#FFA7F3D0</Color>

    <Color x:Key="StatusDangerFill">#FFFEF2F2</Color>
