<!--  Themes/Colors.xaml — full replacement  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ══════════════════════════════════════════════════════════════════
        MediCore Color Palette — v2, modernized
        
        Same key structure as before ({Role}{Shade}), same shade meaning
        (50 lightest → 900 darkest). Values are now drawn from Tailwind
        CSS's Slate/Blue/Teal/Emerald/Amber/Red scales — the same family
        Storix's palette is built on — for a cleaner, more contemporary
        feel while keeping every consuming file (Brushes, Buttons,
        DataGrid, TextBoxes) untouched, since only hex values changed.
        ══════════════════════════════════════════════════════════════════
    -->

    <Color x:Key="White">#FFFFFFFF</Color>
    <Color x:Key="Black">#FF0B0F19</Color>
    <Color x:Key="Transparent">#00FFFFFF</Color>

    <!--  ── PrimaryBlue (Tailwind Blue) ────────────────────────────  -->
    <Color x:Key="PrimaryBlue50">#FFEFF6FF</Color>
    <Color x:Key="PrimaryBlue100">#FFDBEAFE</Color>
    <Color x:Key="PrimaryBlue200">#FFBFDBFE</Color>
    <Color x:Key="PrimaryBlue400">#FF60A5FA</Color>
    <Color x:Key="PrimaryBlue600">#FF2563EB</Color>
    <Color x:Key="PrimaryBlue800">#FF1E40AF</Color>
    <Color x:Key="PrimaryBlue900">#FF1E3A8A</Color>

    <!--  ── ClinicalTeal (Tailwind Teal) ───────────────────────────  -->
    <Color x:Key="ClinicalTeal50">#FFF0FDFA</Color>
    <Color x:Key="ClinicalTeal100">#FFCCFBF1</Color>
    <Color x:Key="ClinicalTeal200">#FF99F6E4</Color>
    <Color x:Key="ClinicalTeal400">#FF2DD4BF</Color>
    <Color x:Key="ClinicalTeal600">#FF0D9488</Color>
    <Color x:Key="ClinicalTeal800">#FF115E59</Color>
    <Color x:Key="ClinicalTeal900">#FF134E4A</Color>

    <!--  ── SuccessGreen (Tailwind Emerald) ────────────────────────  -->
    <Color x:Key="SuccessGreen50">#FFECFDF5</Color>
    <Color x:Key="SuccessGreen100">#FFD1FAE5</Color>
    <Color x:Key="SuccessGreen200">#FFA7F3D0</Color>
    <Color x:Key="SuccessGreen400">#FF34D399</Color>
    <Color x:Key="SuccessGreen600">#FF059669</Color>
    <Color x:Key="SuccessGreen800">#FF065F46</Color>
    <Color x:Key="SuccessGreen900">#FF064E3B</Color>

    <!--  ── WarningAmber (Tailwind Amber) ──────────────────────────  -->
    <Color x:Key="WarningAmber50">#FFFFFBEB</Color>
    <Color x:Key="WarningAmber100">#FFFEF3C7</Color>
    <Color x:Key="WarningAmber200">#FFFDE68A</Color>
    <Color x:Key="WarningAmber400">#FFFBBF24</Color>
    <Color x:Key="WarningAmber600">#FFD97706</Color>
    <Color x:Key="WarningAmber800">#FF92400E</Color>
    <Color x:Key="WarningAmber900">#FF78350F</Color>

    <!--  ── DangerRed (Tailwind Red) ───────────────────────────────  -->
    <Color x:Key="DangerRed50">#FFFEF2F2</Color>
    <Color x:Key="DangerRed100">#FFFEE2E2</Color>
    <Color x:Key="DangerRed200">#FFFECACA</Color>
    <Color x:Key="DangerRed400">#FFF87171</Color>
    <Color x:Key="DangerRed600">#FFDC2626</Color>
    <Color x:Key="DangerRed800">#FF991B1B</Color>
    <Color x:Key="DangerRed900">#FF7F1D1D</Color>

    <!--  ── NeutralGray (Tailwind Slate) ───────────────────────────  -->
    <Color x:Key="NeutralGray50">#FFF8FAFC</Color>
    <Color x:Key="NeutralGray100">#FFF1F5F9</Color>
    <Color x:Key="NeutralGray200">#FFE2E8F0</Color>
    <Color x:Key="NeutralGray300">#FFCBD5E1</Color>
    <Color x:Key="NeutralGray400">#FF94A3B8</Color>
    <Color x:Key="NeutralGray500">#FF64748B</Color>
    <Color x:Key="NeutralGray600">#FF475569</Color>
    <Color x:Key="NeutralGray700">#FF334155</Color>
