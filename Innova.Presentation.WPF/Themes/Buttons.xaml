<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
        <ResourceDictionary Source="Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        ══════════════════════════════════════════════════════════════════
        MediCore Button System
        
        Variants:
        ButtonPrimary     — main CTA  (Save, Register, Book, Issue)
        ButtonSecondary   — secondary action (Edit, View Details)
        ButtonDanger      — destructive (Cancel, Reject, Delete)
        ButtonGhost       — low-emphasis (Cancel form, Back)
        ButtonIcon        — icon-only (toolbar actions)
        ButtonIconText    — icon + label (sidebar nav items)
        ButtonLink        — inline text link
        
        All buttons:
        - Have three states: Normal / Hover / Pressed / Disabled
        - Use CornerRadius 6 for a modern but clinical feel
        - Font: Segoe UI Medium 14
        - Min height: 36px (touch-friendly)
        - Cursor: Hand
        ══════════════════════════════════════════════════════════════════
    -->

    <!--  ── Shared button geometry ──────────────────────────────────  -->
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    <Thickness x:Key="ButtonPaddingNormal">16,8,16,8</Thickness>
    <Thickness x:Key="ButtonPaddingCompact">12,6,12,6</Thickness>

    <!--  ══════════════════════════════════════════════════════════  -->
    <!--  PRIMARY BUTTON  -->
    <!--  Blue fill, white text — main call to action  -->
    <!--  ══════════════════════════════════════════════════════════  -->
    <Style x:Key="ButtonPrimary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBlue600Brush}" />
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="{StaticResource ButtonPaddingNormal}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ButtonCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryBlue800Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryBlue900Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource NeutralGray200Brush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Compact variant — same look, less padding (for toolbars)  -->
    <Style x:Key="ButtonPrimaryCompact"
           BasedOn="{StaticResource ButtonPrimary}"
           TargetType="Button">
        <Setter Property="Padding" Value="{StaticResource ButtonPaddingCompact}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
    </Style>

    <!--  ══════════════════════════════════════════════════════════  -->
    <!--  SECONDARY BUTTON  -->
    <!--  Outlined blue — secondary actions  -->
    <!--  ══════════════════════════════════════════════════════════  -->
    <Style x:Key="ButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBlue600Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlue400Brush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="{StaticResource ButtonPaddingNormal}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ButtonCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryBlue50Brush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBlue600Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryBlue100Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource NeutralGray200Brush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ══════════════════════════════════════════════════════════  -->
