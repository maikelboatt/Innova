<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.Settings.SettingsView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:settings="clr-namespace:Innova.Presentation.Core.Settings;assembly=Innova.Presentation.Core"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel,
                                                   IsDesignTimeCreatable=True}"
                  d:DesignHeight="650"
                  d:DesignWidth="1000"
                  mc:Ignorable="d">

    <Grid Background="{StaticResource Surface1Brush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->

        <TextBlock Grid.Row="0"
                   Margin="24,20,24,16"
                   Style="{StaticResource TextHeading}"
                   Text="{Binding Title}" />

        <Grid Grid.Row="1" Margin="24,0,24,24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Section Navigation  -->

            <StackPanel Grid.Column="0" Margin="0,0,16,0">

                <Button HorizontalContentAlignment="Center"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="Account"
                        Content="Account"
                        Style="{StaticResource ButtonSettingsNav}" />

                <Button HorizontalContentAlignment="Center"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="Users"
                        Content="User Management"
                        Style="{StaticResource ButtonSettingsNav}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button HorizontalContentAlignment="Center"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="AuditLog"
                        Content="Audit Log"
                        Style="{StaticResource ButtonSettingsNav}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />

            </StackPanel>

            <!--  Section Content  -->

            <Grid Grid.Column="1">

                <!--  Account  -->

                <StackPanel Visibility="{Binding IsAccountActive, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Style="{StaticResource TextSubtitle}" Text="Account Information" />

                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource TextBodySecondary}"
                               Text="Username" />

                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource TextBody}"
                               Text="{Binding CurrentUsername}" />

                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource TextBodySecondary}"
                               Text="Role" />

                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource TextBody}"
                               Text="{Binding CurrentUserRole}" />

                    <Button Margin="0,24,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ChangePasswordCommand}"
                            Content="Change Password"
                            Style="{StaticResource ButtonSecondary}" />

                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding SignOutCommand}"
                            Content="Sign Out"
                            Style="{StaticResource ButtonDangerOutline}" />

                </StackPanel>

                <!--  User Management  -->

                <Grid Visibility="{Binding IsUsersActive, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <TextBlock Style="{StaticResource TextSubtitle}" Text="User Management" />

                        <TextBlock Margin="0,4,0,16"
                                   Style="{StaticResource TextBodySecondary}"
                                   Text="Register users and manage their access to Innova." />

                        <Button HorizontalAlignment="Left"
                                Command="{Binding OpenRegisterUserCommand}"
                                Content="+ Add User"
                                Style="{StaticResource ButtonPrimary}" />

                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,20,0,0"
                                  VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding Users}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Margin="0,0,0,8"
                                            Padding="14,10"
                                            Background="{StaticResource Surface2Brush}"
                                            CornerRadius="8">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--  User information  -->

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                                <TextBlock FontWeight="Medium"
                                                           Style="{StaticResource TextBody}"
                                                           Text="{Binding Username}" />

                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Role}" />

                                            </StackPanel>

                                            <!--  Account status  -->

                                            <Border Grid.Column="1"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">

                                                <Border.Style>
                                                    <Style BasedOn="{StaticResource BadgeDefault}" TargetType="Border">

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">

                                                                <Setter Property="Background" Value="{StaticResource StatusSuccessFillBrush}" />

                                                                <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">

                                                                <Setter Property="Background" Value="{StaticResource StatusDangerFillBrush}" />

                                                                <Setter Property="BorderBrush" Value="{StaticResource StatusDangerBorderBrush}" />

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>
                                                </Border.Style>

                                                <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                                           FontWeight="Medium"
                                                           Text="{Binding StatusLabel}">

                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">

                                                                    <Setter Property="Foreground" Value="{StaticResource StatusSuccessTextBrush}" />

                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">

                                                                    <Setter Property="Foreground" Value="{StaticResource StatusDangerTextBrush}" />

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>
                                                    </TextBlock.Style>

                                                </TextBlock>

                                            </Border>

                                            <!--  Current user indicator  -->

                                            <TextBlock Grid.Column="2"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TextCaption}"
                                                       Text="You"
                                                       Visibility="{Binding IsCurrentUser, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!--  Deactivate  -->

                                            <Button Grid.Column="3"
                                                    Command="{Binding DataContext.DeactivateUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Deactivate"
                                                    Style="{StaticResource ButtonDangerOutline}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!--  Reactivate  -->

                                            <Button Grid.Column="3"
                                                    Command="{Binding DataContext.ReactivateUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Reactivate"
                                                    Style="{StaticResource ButtonSecondary}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

                <!--  Audit Log  -->

                <Grid Visibility="{Binding IsAuditLogActive, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <TextBlock Style="{StaticResource TextSubtitle}" Text="Audit Log" />

                        <TextBlock Margin="0,4,0,16"
                                   Style="{StaticResource TextBodySecondary}"
                                   Text="Review recent system activity." />

                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding AuditLogEntries}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Margin="0,0,0,8"
                                            Padding="12,10"
                                            Background="{StaticResource Surface2Brush}"
                                            CornerRadius="8">

                                        <StackPanel>

                                            <TextBlock Style="{StaticResource TextBody}">

                                                <Run FontWeight="Medium" Text="{Binding EventName, Mode=OneWay}" />

                                                <Run Text=" by " />

                                                <Run FontWeight="Medium" Text="{Binding UserName, Mode=OneWay}" />

                                                <Run Text=" — " />

                                                <Run Text="{Binding OccurredAtDisplay, Mode=OneWay}" />

                                            </TextBlock>

                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource TextBodySecondary}"
                                                       Text="{Binding Summary}" />

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</views:MvxWpfView>