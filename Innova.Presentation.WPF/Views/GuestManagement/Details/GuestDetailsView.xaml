<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.GuestManagement.Details.GuestDetailsView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:details="clr-namespace:Innova.Presentation.Core.GuestManagement.Details;assembly=Innova.Presentation.Core"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  d:DataContext="{d:DesignInstance Type=details:GuestDetailsViewModel,
                                                   IsDesignTimeCreatable=True}"
                  d:DesignHeight="auto"
                  d:DesignWidth="auto"
                  mc:Ignorable="d">

    <Grid Width="520" Background="{StaticResource Surface3Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ── Header ───────────────────────────────────────────  -->
        <Grid Grid.Row="0" Margin="24,20,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextHeading}" Text="{Binding FullName}" />
                    <Border Margin="10,2,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style BasedOn="{StaticResource BadgeDefault}" TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusBadge}" Value="Success">
                                        <Setter Property="Background" Value="{StaticResource StatusSuccessFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusBadge}" Value="Danger">
                                        <Setter Property="Background" Value="{StaticResource StatusDangerFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusDangerBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="Medium"
                                   Text="{Binding StatusLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusBadge}" Value="Success">
                                            <Setter Property="Foreground" Value="{StaticResource StatusSuccessTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusBadge}" Value="Danger">
                                            <Setter Property="Foreground" Value="{StaticResource StatusDangerTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource TextBodySecondary}">
                    <Run Text="{Binding Age, Mode=OneWay, StringFormat='{}{0} yrs'}" />
                    <Run Text=" · " />
                    <Run Text="{Binding DateOfBirth, Mode=OneWay, StringFormat=dd MMM yyyy}" />
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource ButtonIcon}">
                <Path Width="14"
                      Height="14"
                      Data="{StaticResource IconClose}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform" />
            </Button>
        </Grid>

        <!--  ── Read-only body ───────────────────────────────────  -->
        <ScrollViewer Grid.Row="1"
                      MaxHeight="520"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,8">

                <TextBlock Margin="0,12,0,8"
                           Style="{StaticResource TextSubtitle}"
                           Text="Contact" />
                <StackPanel>
                    <TextBlock Style="{StaticResource TextLabel}" Text="Phone" />
                    <TextBlock Margin="0,2,0,10"
                               Style="{StaticResource TextBody}"
                               Text="{Binding PhoneNumber}" />
                    <TextBlock Style="{StaticResource TextLabel}" Text="Email" />
                    <TextBlock Margin="0,2,0,10"
                               Style="{StaticResource TextBody}"
                               Text="{Binding Email}" />
                </StackPanel>

                <TextBlock Margin="0,20,0,8"
                           Style="{StaticResource TextSubtitle}"
                           Text="Identity Document" />
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBody}">
                        <Run Text="{Binding IdentityDocumentType, Mode=OneWay}" />
                        <Run Text=" (" />
                        <Run Text="{Binding IdentityDocumentNumber, Mode=OneWay}" />
                        <Run Text=")" />
                    </TextBlock>
                </StackPanel>


                <TextBlock Margin="0,20,0,0" Style="{StaticResource TextCaption}">
                    <Run Text="Registered " />
                    <Run Text="{Binding RegisteredAt, Mode=OneWay, StringFormat=dd MMM yyyy}" />
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <!--  ── Footer actions ──────────────────────────────────────  -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,14,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding DeactivateCommand}"
                        Content="Unregister Patient"
                        Style="{StaticResource ButtonDangerOutline}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding CloseCommand}"
                            Content="Close"
                            Style="{StaticResource ButtonGhost}" />
                    <Button Command="{Binding EditCommand}"
                            Content="Edit Patient"
                            Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:MvxWpfView>