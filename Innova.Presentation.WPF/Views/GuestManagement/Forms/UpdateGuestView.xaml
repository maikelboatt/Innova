<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.GuestManagement.Forms.UpdateGuestView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:forms="clr-namespace:Innova.Presentation.Core.GuestManagement.Forms;assembly=Innova.Presentation.Core"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  d:DataContext="{d:DesignInstance Type=forms:UpdateGuestViewModel,
                                                   IsDesignTimeCreatable=True}"
                  d:DesignHeight="auto"
                  d:DesignWidth="auto"
                  mc:Ignorable="d">

    <Grid Width="560" Background="{StaticResource Surface3Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,4">
            <TextBlock Style="{StaticResource TextHeading}" Text="Edit Guest" />
            <TextBlock Margin="0,2,0,0"
                       Style="{StaticResource TextBodySecondary}"
                       Text="{Binding FullNameDisplay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      MaxHeight="560"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,8">

                <TextBlock Margin="0,12,0,8"
                           Style="{StaticResource TextSubtitle}"
                           Text="Contact" />

                <StackPanel>
                    <TextBlock Margin="0,0,0,4"
                               Style="{StaticResource TextLabel}"
                               Text="Phone Number" />
                    <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Margin="0,0,0,4"
                               Style="{StaticResource TextLabel}"
                               Text="Email" />
                    <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>


                <TextBlock Margin="0,20,0,8"
                           Style="{StaticResource TextSubtitle}"
                           Text="Identity Document" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,4"
                                   Style="{StaticResource TextLabel}"
                                   Text="Document Number" />
                        <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding IdentityDocumentNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,4"
                                   Style="{StaticResource TextLabel}"
                                   Text="Document Type" />
                        <ComboBox ItemsSource="{Binding IdentityDocumentTypes}"
                                  SelectedItem="{Binding IdentityDocumentType, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ComboBoxDefault}" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Margin="24,14,24,14"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        Style="{StaticResource ButtonGhost}" />
                <Button Command="{Binding SaveCommand}"
                        Content="Save Changes"
                        Style="{StaticResource ButtonPrimary}" />
            </StackPanel>
        </Border>
    </Grid>
</views:MvxWpfView>