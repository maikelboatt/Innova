<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.Reservations.GroupBooking.Forms.OpenGroupBookingView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:forms="clr-namespace:Innova.Presentation.Core.Reservations.GroupBooking.Forms;assembly=Innova.Presentation.Core"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  d:DataContext="{d:DesignInstance Type=forms:OpenGroupBookingViewModel,
                                                   IsDesignTimeCreatable=True}"
                  d:DesignHeight="auto"
                  d:DesignWidth="auto"
                  mc:Ignorable="d">

    <Grid Width="560" Background="{StaticResource Surface3Brush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="24,20,24,4">

            <TextBlock Style="{StaticResource TextHeading}" Text="Open Group Booking" />

            <TextBlock Margin="0,2,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Style="{StaticResource TextBody}"
                       Text="Create a group booking for guests staying together." />

        </StackPanel>

        <!--  Scrollable form body  -->
        <ScrollViewer Grid.Row="1"
                      MaxHeight="560"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="24,8,24,8">

                <!--  Group details  -->
                <TextBlock Margin="0,12,0,8"
                           Style="{StaticResource TextSubtitle}"
                           Text="Group Details" />

                <!--  Organizer  -->
                <StackPanel>

                    <TextBlock Margin="0,0,0,4"
                               Style="{StaticResource TextLabel}"
                               Text="Organizer Guest ID" />

                    <TextBox IsReadOnly="True"
                             Style="{StaticResource TextBoxDefault}"
                             Text="{Binding OrganizerGuestId, Mode=OneWay}" />

                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource TextCaption}"
                               Text="The guest responsible for organizing this booking." />

                </StackPanel>

                <!--  Group name  -->
                <StackPanel Margin="0,16,0,0">

                    <TextBlock Margin="0,0,0,4"
                               Style="{StaticResource TextLabel}"
                               Text="Group Name *" />

                    <TextBox MaxLength="150"
                             Style="{StaticResource TextBoxDefault}"
                             Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource TextCaption}"
                               Text="For example, Corporate Retreat, Wedding Guests or Family Reunion." />

                </StackPanel>

                <!--  Information  -->
                <Border Margin="0,20,0,0"
                        Padding="12"
                        Background="{StaticResource Surface2Brush}"
                        CornerRadius="6">

                    <StackPanel>

                        <TextBlock Style="{StaticResource TextSubtitle}" Text="What's Next?" />

                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource TextBody}"
                                   Text="After creating the group booking, you can associate individual reservations with it." />

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!--  Footer actions  -->
        <Grid Grid.Row="2" Margin="24,12,24,24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Return to single reservation  -->
            <Button Grid.Column="1"
                    MinWidth="120"
                    Command="{Binding ToSingleReservationCommand}"
                    Content="Single Reservation"
                    Style="{StaticResource ButtonSecondary}" />

            <Button Grid.Column="3"
                    MinWidth="80"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    Style="{StaticResource ButtonGhost}" />

            <Button Grid.Column="5"
                    MinWidth="150"
                    Command="{Binding SaveCommand}"
                    Content="Create Group Booking"
                    IsEnabled="{Binding IsSaveEnabled}"
                    Style="{StaticResource ButtonPrimary}" />

        </Grid>

    </Grid>

</views:MvxWpfView>