<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.Reservations.Reservations.Lists.ReservationListView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:lists="clr-namespace:Innova.Presentation.Core.Reservations.Reservation.Lists;assembly=Innova.Presentation.Core"
                  xmlns:loadingSpinnerControl="clr-namespace:LoadingSpinnerControl;assembly=LoadingSpinnerControl"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  d:DataContext="{d:DesignInstance Type=lists:ReservationListViewModel,
                                                   IsDesignTimeCreatable=True}"
                  d:DesignHeight="600"
                  d:DesignWidth="1000"
                  mc:Ignorable="d">
    <Grid Background="{StaticResource Surface1Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Header  -->
            <RowDefinition Height="Auto" />
            <!--  Toolbar: search + actions  -->
            <RowDefinition Height="*" />
            <!--  Grid / empty state  -->
        </Grid.RowDefinitions>

        <!--  ── Header ───────────────────────────────────────────  -->
        <Grid Grid.Row="0" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource TextHeading}"
                       Text="{Binding Title}" />

        </Grid>

        <!--  ── Toolbar: search + refresh ───────────────────────────  -->
        <Grid Grid.Row="1" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource TextBoxSearch}"
                     Tag="Search by stay period, booking type, status, or rate"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource ButtonIcon}"
                    ToolTip="Refresh">
                <Path Width="18"
                      Height="18"
                      Data="{StaticResource IconRefresh}"
                      Fill="{StaticResource TextSecondaryBrush}"
                      Stretch="Uniform" />
            </Button>
        </Grid>

        <!--  ── Content: grid or empty state ────────────────────────  -->
        <Grid Grid.Row="2" Margin="24,0,24,24">

            <!--  Loading skeleton overlay  -->
            <Border Background="{StaticResource Surface1Brush}"
                    Opacity="0.85"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                    <loadingSpinnerControl:LoadingSpinner Diameter="100"
                                                          IsLoading="{Binding IsLoading}"
                                                          Thickness="3" />

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource TextBodySecondary}"
                               Text="Loading info..." />
                </StackPanel>
            </Border>

            <!--  Data grid  -->
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      Style="{StaticResource DataGridDefault}"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.InputBindings>
                    <MouseBinding Command="{Binding SelectCommand}"
                                  CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                  MouseAction="LeftDoubleClick" />
                </DataGrid.InputBindings>

                <DataGrid.Columns>

                    <DataGridTextColumn Width="1*"
                                        Binding="{Binding GuestName}"
                                        Header="Guest Name" />

                    <DataGridTextColumn Width="1.5*"
                                        Binding="{Binding RoomTypeName}"
                                        Header="Room Type" />

                    <DataGridTextColumn Width="1.5*"
                                        Binding="{Binding StayPeriodDisplay}"
                                        Header="Period" />

                    <DataGridTextColumn Width="1.5*"
                                        Binding="{Binding NightlyRateDisplay}"
                                        Header="Rate" />

                    <!--  Status badge  -->
                    <DataGridTemplateColumn Width="150" Header="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style BasedOn="{StaticResource BadgeDefault}" TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusBadge}" Value="Success">
                                                    <Setter Property="Background" Value="{StaticResource StatusSuccessFillBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusBadge}" Value="Danger">
                                                    <Setter Property="Background" Value="{StaticResource StatusDangerFillBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource StatusDangerBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                               FontWeight="Medium"
                                               Text="{Binding StatusLabel}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusBadge}" Value="Success">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusSuccessTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusBadge}" Value="Danger">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusDangerTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Operations column  -->
                    <DataGridTemplateColumn Width="Auto" Header="Operations">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">

                                    <Button Margin="0,0,4,0"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.OpenReservationDetailsCommand}"
                                            CommandParameter="{Binding ReservationId}"
                                            Style="{StaticResource ButtonRowActionView}"
                                            ToolTip="View Details">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource IconEyeOn}"
                                              Fill="{StaticResource WhiteBrush}"
                                              Stretch="Uniform" />
                                    </Button>

                                    <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.OpenReservationEditCommand}"
                                            CommandParameter="{Binding ReservationId}"
                                            Style="{StaticResource ButtonRowActionEdit}"
                                            ToolTip="Edit Reservation">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource IconEdit}"
                                              Fill="{StaticResource WhiteBrush}"
                                              Stretch="Uniform" />
                                    </Button>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!--  Empty state: only when there is nothing to show AND we are not loading  -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Path Width="48"
                      Height="48"
                      Margin="0,0,0,12"
                      HorizontalAlignment="Center"
                      Data="{StaticResource ReservationIcon}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform" />
                <TextBlock HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Style="{StaticResource TextBody}"
                           Text="No reservations found" />
                <TextBlock Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource TextBodySecondary}"
                           Text="Try a different search, or create a new reservation." />
            </StackPanel>

            <!--  Loading skeleton overlay  -->
            <Border Background="{StaticResource Surface1Brush}"
                    Opacity="0.85"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                    <loadingSpinnerControl:LoadingSpinner Diameter="100"
                                                          IsLoading="{Binding IsLoading}"
                                                          Thickness="3" />


                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource TextBodySecondary}"
                               Text="Loading reservations..." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</views:MvxWpfView>