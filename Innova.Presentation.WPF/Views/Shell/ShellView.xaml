<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.Shell.ShellView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:modalDialogControl="clr-namespace:ModalDialogControl;assembly=ModalDialogControl"
                  xmlns:resources="clr-namespace:Innova.Presentation.WPF.Resources"
                  xmlns:shell="clr-namespace:Innova.Presentation.Core.Shell;assembly=Innova.Presentation.Core"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  x:Name="Shell"
                  d:DataContext="{d:DesignInstance Type=shell:ShellViewModel,
                                                   IsDesignTimeCreatable=True}"
                  d:DesignHeight="750"
                  d:DesignWidth="1200"
                  Loaded="ShellView_OnLoaded"
                  mc:Ignorable="d">
    <!--
        ══════════════════════════════════════════════════════════════
        Root — outer border with corner radius for frameless window
        ══════════════════════════════════════════════════════════════════
    -->
    <Border Background="{StaticResource Surface1Brush}"
            CornerRadius="10"
            UseLayoutRounding="True">

        <Grid>
            <Grid.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=Border}" />
            </Grid.OpacityMask>

            <modalDialogControl:ModalDialog MinWidth="0"
                                            MaxWidth="640"
                                            Panel.ZIndex="10"
                                            CornerRadius="10"
                                            IsOpen="{Binding IsModalOpen}"
                                            TheBackground="{StaticResource Surface2Brush}"
                                            TheShadow="{StaticResource BlackBrush}">
                <ContentControl HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{Binding CurrentModalContent}" />
            </modalDialogControl:ModalDialog>

            <!--
                ══════════════════════════════════════════════════════════════
                TOAST HOST — transient notifications (Notifications.ShowError,
                ShowSuccess, etc.), rendered independently of any modal system.
                Fixed to the top-right corner; each toast auto-dismisses via
                NotificationService's own Task.Delay, or manually via the X
                button → DismissNotificationCommand. Panel.ZIndex="30" — above
                every modal overlay, since a toast should stay visible even
                while a form or confirm dialog is open on screen.
                
                IsHitTestVisible="False" on the outer Grid but "True" on each
                toast Border: lets clicks pass through the empty space around
                toasts to whatever's underneath, while toasts themselves remain
                clickable (for their dismiss button).
                ══════════════════════════════════════════════════════════════
            -->
            <Grid Panel.ZIndex="300" IsHitTestVisible="False">
                <ItemsControl Margin="0,20,20,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              IsHitTestVisible="True"
                              ItemsSource="{Binding Toasts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="340"
                                    Margin="0,0,0,10"
                                    Padding="14,12"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                                      Direction="270"
                                                      Opacity="0.15"
                                                      ShadowDepth="4"
                                                      Color="{StaticResource Black}" />
                                </Border.Effect>

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource StatusActiveFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusActiveBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Success">
                                                <Setter Property="Background" Value="{StaticResource StatusSuccessFillBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                <Setter Property="Background" Value="{StaticResource StatusWarningFillBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Error">
                                                <Setter Property="Background" Value="{StaticResource StatusDangerFillBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusDangerBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Path Grid.Column="0"
                                          Width="18"
                                          Height="18"
                                          Margin="0,1,10,0"
                                          VerticalAlignment="Top"
                                          Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource IconInfo}" />
                                                <Setter Property="Fill" Value="{StaticResource StatusActiveTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Success">
                                                        <Setter Property="Data" Value="{StaticResource IconSuccess}" />
                                                        <Setter Property="Fill" Value="{StaticResource StatusSuccessTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                        <Setter Property="Data" Value="{StaticResource IconWarning}" />
                                                        <Setter Property="Fill" Value="{StaticResource StatusWarningTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Error">
                                                        <Setter Property="Data" Value="{StaticResource IconError}" />
                                                        <Setter Property="Fill" Value="{StaticResource StatusDangerTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource TextBody}"
                                               Text="{Binding Message}" />

                                    <Button Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            Padding="4"
                                            VerticalAlignment="Top"
                                            Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource ButtonIcon}">
                                        <Path Width="10"
                                              Height="10"
                                              Data="{StaticResource IconClose}"
                                              Fill="{StaticResource TextMutedBrush}"
                                              Stretch="Uniform" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!--
                ══════════════════════════════════════════════════════
                MAIN LAYOUT — two columns: nav rail | content
                ══════════════════════════════════════════════════════════
            -->
            <Border x:Name="Border" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!--  Nav column — Width animated by hamburger toggle  -->
                        <ColumnDefinition x:Name="NavColumn" Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        ══════════════════════════════════════════════════
                        LEFT NAV RAIL
                        ══════════════════════════════════════════════════════
                    -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SecondaryBackgroundColor}"
                            CornerRadius="10,0,0,10">

                        <Grid x:Name="GridNav" Width="250">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64" />
                                <!--  Logo / brand  -->
                                <RowDefinition Height="*" />

                                <RowDefinition Height="64" />
                                <!--  User / bottom  -->
                            </Grid.RowDefinitions>

                            <!--  ── Logo area ───────────────────────────  -->
                            <Border Grid.Row="0"
                                    Padding="16,0"
                                    VerticalAlignment="Center"
                                    MouseDown="LogoArea_OnMouseDown">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                    <!--  Logo mark  -->
                                    <Border Width="32"
                                            Height="32"
                                            Background="{StaticResource PrimaryBlue600Brush}"
                                            CornerRadius="8">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource WhiteBrush}"
                                                   Text="M" />
                                    </Border>

                                    <!--  App name — hidden when nav is collapsed  -->
                                    <TextBlock x:Name="AppNameLabel"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource WhiteBrush}"
                                               Text="Innova" />
                                </StackPanel>
                            </Border>

                            <!--  ── Nav items ───────────────────────────  -->
                            <ScrollViewer Grid.Row="1"
                                          Padding="0,8,0,8"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="NavButtonsPanel">


                                    <!--  Dashboard  -->
                                    <Button x:Name="BtnDashboard"
                                            Margin="0,10,0,2"
                                            MouseEnter="BtnDashboard_MouseEnter"
                                            MouseLeave="BtnDashboard_MouseLeave"
                                            Style="{DynamicResource PopupButtonStyle}">
                                        <resources:NavigationItem Padding="0,8"
                                                                  CommandName="{Binding NavigateToDashboardCommand}"
                                                                  GroupName="MenuItem"
                                                                  Icon="{DynamicResource IconDashboard}"
                                                                  IconWidth="18"
                                                                  IndicatorBrush="{DynamicResource PrimaryBlue50Brush}"
                                                                  IsSelected="True"
                                                                  Text="Dashboard" />
                                    </Button>

                                    <!--  Separator  -->
                                    <Separator Margin="16,8,16,8" Background="{StaticResource SidebarDividerBrush}" />

                                    <!--  Guest  -->
                                    <Button x:Name="BtnGuest"
                                            Margin="0,2,0,2"
                                            MouseEnter="BtnGuest_MouseEnter"
                                            MouseLeave="BtnGuest_MouseLeave"
                                            Style="{DynamicResource PopupButtonStyle}">
                                        <resources:NavigationItem Padding="0,8"
                                                                  CommandName="{Binding NavigateToGuestsCommand}"
                                                                  GroupName="MenuItem"
                                                                  Icon="{DynamicResource IconGuests}"
                                                                  IconWidth="18"
                                                                  IndicatorBrush="{DynamicResource PrimaryBlue50Brush}"
                                                                  Text="Guests" />
                                    </Button>

                                    <!--  Room Inventory (Expandable)  -->
                                    <StackPanel Margin="0,2,0,2">
                                        <ToggleButton x:Name="RoomInventoryExpander"
                                                      MouseEnter="BtnRoomInventory_MouseEnter"
                                                      MouseLeave="BtnRoomInventory_MouseLeave"
                                                      Style="{DynamicResource MenuToggleButtonStyle}"
                                                      Tag="{DynamicResource RoomInventory}">
                                            <Grid Height="40">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Path Grid.Column="0"
                                                      Width="18"
                                                      Height="18"
                                                      Margin="21,0,0,0"
                                                      Data="{DynamicResource RoomInventory}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      Stretch="Uniform" />

                                                <TextBlock Grid.Column="1"
                                                           Margin="18,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Text="Room Inventory" />

                                                <Path Grid.Column="2"
                                                      Width="8"
                                                      Height="8"
                                                      Margin="0,0,15,0"
                                                      Data="M7 10L12 15L17 10H7Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      RenderTransformOrigin="0.5,0.5"
                                                      Stretch="Uniform">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="RoomInventoryArrow" Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </ToggleButton>

                                        <!--  Inventory Sub-items  -->
                                        <StackPanel x:Name="RoomInventorySubItems"
                                                    Margin="0,2,0,2"
                                                    Visibility="Collapsed">
                                            <Button x:Name="BtnRooms"
                                                    Margin="0,0,0,2"
                                                    MouseEnter="BtnRooms_MouseEnter"
                                                    MouseLeave="BtnRooms_MouseLeave"
                                                    Style="{DynamicResource PopupButtonStyle}">
                                                <resources:NavigationItem Padding="0,6"
                                                                          CommandName="{Binding NavigateToRoomsCommand}"
                                                                          GroupName="MenuItem"
                                                                          Icon="{DynamicResource RoomIcon}"
                                                                          IconMargin="23,0,0,0"
                                                                          IconWidth="14"
                                                                          IndicatorBrush="{DynamicResource PrimaryBlueColor}"
                                                                          IsSubMenuItem="True"
                                                                          Text="Rooms" />
                                            </Button>

                                            <Button x:Name="BtnRoomDefinitions"
                                                    Margin="0,0,0,2"
                                                    MouseEnter="BtnRoomDefinitions_MouseEnter"
                                                    MouseLeave="BtnRoomDefinitions_MouseLeave"
                                                    Style="{DynamicResource PopupButtonStyle}">
                                                <resources:NavigationItem Padding="0,6"
                                                                          CommandName="{Binding NavigateToRoomDefinitionsCommand}"
                                                                          GroupName="MenuItem"
                                                                          Icon="{DynamicResource RoomDefinitionIcon}"
                                                                          IconMargin="23,0,0,0"
                                                                          IconWidth="14"
                                                                          IndicatorBrush="{DynamicResource PrimaryBlueColor}"
                                                                          IsSubMenuItem="True"
                                                                          Text="Room Definitions" />
                                            </Button>

                                            <Button x:Name="BtnRoomAllotments"
                                                    Margin="0,0,0,2"
                                                    MouseEnter="BtnRoomAllotments_MouseEnter"
                                                    MouseLeave="BtnRoomAllotments_MouseLeave"
                                                    Style="{DynamicResource PopupButtonStyle}">
                                                <resources:NavigationItem Padding="0,6"
                                                                          CommandName="{Binding NavigateToRoomAllotmentsCommand}"
                                                                          GroupName="MenuItem"
                                                                          Icon="{DynamicResource RoomAllotmentIcon}"
                                                                          IconMargin="23,0,0,0"
                                                                          IconWidth="14"
                                                                          IndicatorBrush="{DynamicResource PrimaryBlueColor}"
                                                                          IsSubMenuItem="True"
                                                                          Text="Room Allotments" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  Reservations (Expandable)  -->
                                    <StackPanel Margin="0,2,0,2">
                                        <ToggleButton x:Name="ReservationsExpander"
                                                      MouseEnter="BtnReservations_MouseEnter"
                                                      MouseLeave="BtnReservations_MouseLeave"
                                                      Style="{DynamicResource MenuToggleButtonStyle}"
                                                      Tag="{DynamicResource Reservations}">
                                            <Grid Height="40">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Path Grid.Column="0"
                                                      Width="18"
                                                      Height="18"
                                                      Margin="21,0,0,0"
                                                      Data="{DynamicResource Reservations}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      Stretch="Uniform" />

                                                <TextBlock Grid.Column="1"
                                                           Margin="18,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Text="Reservations" />

                                                <Path Grid.Column="2"
                                                      Width="8"
                                                      Height="8"
                                                      Margin="0,0,15,0"
                                                      Data="M7 10L12 15L17 10H7Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      RenderTransformOrigin="0.5,0.5"
                                                      Stretch="Uniform">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="OrdersArrow" Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </ToggleButton>

                                        <!--  Orders Sub-items  -->
                                        <StackPanel x:Name="ReservationSubItems"
                                                    Margin="0,2,0,2"
                                                    Visibility="Collapsed">
                                            <Button x:Name="BtnSingleReservations"
                                                    Margin="0,0,0,2"
                                                    MouseEnter="BtnSingleReservations_MouseEnter"
                                                    MouseLeave="BtnSingleReservations_MouseLeave"
                                                    Style="{DynamicResource PopupButtonStyle}">
                                                <resources:NavigationItem Padding="20,6"
                                                                          CommandName="{Binding NavigateToSingleReservationsCommand}"
                                                                          GroupName="MenuItem"
                                                                          Icon="{DynamicResource ReservationIcon}"
                                                                          IconMargin="0,0,0,0"
                                                                          IconWidth="14"
                                                                          IndicatorBrush="{DynamicResource PrimaryBlueColor}"
                                                                          Text="Single Reservations" />
                                            </Button>

                                            <Button x:Name="BtnGroupBookings"
                                                    Margin="0,0,0,2"
                                                    MouseEnter="BtnGroupBookings_MouseEnter"
                                                    MouseLeave="BtnGroupBookings_MouseLeave"
                                                    Style="{DynamicResource PopupButtonStyle}">
                                                <resources:NavigationItem Padding="20,6"
                                                                          CommandName="{Binding NavigateToGroupBookingsCommand}"
                                                                          GroupName="MenuItem"
                                                                          Icon="{DynamicResource GroupBookingIcon}"
                                                                          IconMargin="0,0,0,0"
                                                                          IconWidth="14"
                                                                          IndicatorBrush="{DynamicResource PrimaryBlueColor}"
                                                                          Text="Group Bookings" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  Front-Desk  -->
                                    <Button x:Name="BtnStay"
                                            Margin="0,2,0,2"
                                            MouseEnter="BtnStay_MouseEnter"
                                            MouseLeave="BtnStay_MouseLeave"
                                            Style="{DynamicResource PopupButtonStyle}">
                                        <resources:NavigationItem Padding="0,8"
                                                                  CommandName="{Binding NavigateToStayCommand}"
                                                                  GroupName="MenuItem"
                                                                  Icon="{DynamicResource IconStay}"
                                                                  IconWidth="18"
                                                                  IndicatorBrush="{DynamicResource PrimaryBlueColor}"
                                                                  Text="Stay" />
                                    </Button>

                                    <!--  House Keeping  -->
                                    <Button x:Name="BtnHouseKeeping"
                                            Margin="0,2,0,2"
                                            MouseEnter="BtnHouseKeeping_MouseEnter"
                                            MouseLeave="BtnHouseKeeping_MouseLeave"
                                            Style="{DynamicResource PopupButtonStyle}">
                                        <resources:NavigationItem Padding="0,8"
                                                                  CommandName="{Binding NavigateToHouseKeepingCommand}"
                                                                  GroupName="MenuItem"
                                                                  Icon="{DynamicResource IconHousekeeping}"
                                                                  IconWidth="18"
                                                                  IndicatorBrush="{DynamicResource PrimaryBlueColor}"
                                                                  Text="HouseKeeping" />
                                    </Button>

                                    <!--  Billing Folio  -->
                                    <Button x:Name="BtnBilling"
                                            Margin="0,2,0,2"
                                            MouseEnter="BtnBilling_MouseEnter"
                                            MouseLeave="BtnBilling_MouseLeave"
                                            Style="{DynamicResource PopupButtonStyle}">
                                        <resources:NavigationItem Padding="0,8"
                                                                  CommandName="{Binding NavigateToBillingCommand}"
                                                                  GroupName="MenuItem"
                                                                  Icon="{DynamicResource IconBilling}"
                                                                  IconWidth="18"
                                                                  IndicatorBrush="{DynamicResource PrimaryBlueColor}"
                                                                  Text="Billing" />
                                    </Button>

                                    <!--  Separator  -->
                                    <Separator Margin="16,8,16,8" Background="{StaticResource SidebarDividerBrush}" />

                                    <!--  Settings  -->
                                    <Button x:Name="BtnSettings"
                                            Margin="0,2,0,2"
                                            MouseEnter="BtnSettings_MouseEnter"
                                            MouseLeave="BtnSettings_MouseLeave"
                                            Style="{DynamicResource PopupButtonStyle}">
                                        <resources:NavigationItem Padding="0,8"
                                                                  CommandName="{Binding NavigateToSettingsCommand}"
                                                                  GroupName="MenuItem"
                                                                  Icon="{DynamicResource IconSettings}"
                                                                  IconWidth="18"
                                                                  IndicatorBrush="{DynamicResource PrimaryBlueColor}"
                                                                  Text="Settings" />
                                    </Button>

                                </StackPanel>
                            </ScrollViewer>

                            <!--  ── Bottom bar — settings + version ─────  -->
                            <Border Grid.Row="2"
                                    Padding="16,0"
                                    BorderBrush="{StaticResource SidebarDividerBrush}"
                                    BorderThickness="0,1,0,0">

                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Clinic initials avatar  -->
                                    <Border Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            Background="{StaticResource ClinicalTeal600Brush}"
                                            CornerRadius="16">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource WhiteBrush}"
                                                   Text="MC" />
                                    </Border>

                                    <!--  Hotel name + version — hidden when collapsed  -->
                                    <StackPanel x:Name="HotelInfo"
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource SidebarTextActiveBrush}"
                                                   Text="Innova Hotel" />
                                        <TextBlock FontSize="10"
                                                   Foreground="{StaticResource SidebarTextBrush}"
                                                   Text="v1.0.0" />
                                    </StackPanel>
                                </Grid>

                            </Border>
                            <!--  Popup user control  -->
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   HorizontalOffset="0"
                                   VerticalOffset="10">
                                <resources:UserPopUp x:Name="PopupHeader" Foreground="{DynamicResource ForegroundBrush}" />
                            </Popup>
                        </Grid>
                    </Border>

                    <!--
                        ══════════════════════════════════════════════════
                        RIGHT SIDE — top bar + content area
                        ══════════════════════════════════════════════════════
                    -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60" />
                            <!--  Top bar  -->
                            <RowDefinition Height="*" />
                            <!--  Content  -->
                        </Grid.RowDefinitions>

                        <!--  ── Top bar ──────────────────────────────────  -->
                        <Border Grid.Row="0"
                                Padding="8,0,12,0"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                MouseDown="TopBar_OnMouseDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <!--  Hamburger  -->
                                    <ColumnDefinition Width="*" />
                                    <!--  Breadcrumb  -->
                                    <ColumnDefinition Width="Auto" />
                                    <!--  Window chrome  -->
                                </Grid.ColumnDefinitions>

                                <!--  Hamburger toggle — animates nav width  -->
                                <ToggleButton x:Name="TgBtn"
                                              Grid.Column="0"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="True"
                                              Style="{StaticResource AnimatedHamburgerToggleStyle}">
                                    <!--  Nav expand/collapse animation  -->
                                    <ToggleButton.Triggers>
                                        <!--  Animation for collapsing the navigation panel  -->
                                        <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                            <BeginStoryboard>
                                                <Storyboard x:Name="HideStackPanel">
                                                    <DoubleAnimation BeginTime="0:0:0"
                                                                     Storyboard.TargetName="GridNav"
                                                                     Storyboard.TargetProperty="Width"
                                                                     From="250"
                                                                     To="60"
                                                                     Duration="0:0:0.3" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <!--  Animation for expanding the navigation panel  -->
                                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                                            <BeginStoryboard>
                                                <Storyboard x:Name="ShowStackPanel">
                                                    <DoubleAnimation BeginTime="0:0:0"
                                                                     Storyboard.TargetName="GridNav"
                                                                     Storyboard.TargetProperty="Width"
                                                                     From="60"
                                                                     To="250"
                                                                     Duration="0:0:0.3" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ToggleButton.Triggers>
                                </ToggleButton>

                                <!--  Breadcrumb  -->
                                <TextBlock Grid.Column="1"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource TextBodySecondary}"
                                           Text="{Binding Breadcrumb}" />

                                <!--  Window chrome — minimize / maximize / close  -->
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">

                                    <Button Click="MinimizeButton_OnClick"
                                            Style="{StaticResource ButtonIcon}"
                                            ToolTip="Minimise">
                                        <Path Width="14"
                                              Height="14"
                                              Data="{StaticResource IconWindowMinimize}"
                                              Fill="{StaticResource NeutralGray600Brush}"
                                              Stretch="Uniform" />
                                    </Button>

                                    <Button x:Name="RestoreButton"
                                            Margin="2,0"
                                            Click="RestoreButton_OnClick"
                                            ToolTip="Maximise">
                                        <Path x:Name="RestoreIcon"
                                              Width="14"
                                              Height="14"
                                              Data="{StaticResource IconWindowMaximize}"
                                              Fill="{StaticResource NeutralGray600Brush}"
                                              Stretch="Uniform" />
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button" />
                                        </Button.Style>
                                    </Button>

                                    <Button Click="CloseButton_OnClick" ToolTip="Close">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CloseBg"
                                                        Padding="6"
                                                        Background="Transparent"
                                                        CornerRadius="6">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Data="{StaticResource IconClose}"
                                                          Fill="{StaticResource NeutralGray600Brush}"
                                                          Stretch="Uniform" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CloseBg" Property="Background" Value="{StaticResource DangerRed600Brush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  ── Dynamic content area ─────────────────────  -->
                        <!--
                            CurrentMainContent is set by IContentService.
                            DataTemplate in Resources above resolves the
                            correct View for each ViewModel type.
                            No code-behind needed for content switching.
                        -->
                        <ContentControl Grid.Row="1"
                                        Margin="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Content="{Binding CurrentMainContent}" />

                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:MvxWpfView>