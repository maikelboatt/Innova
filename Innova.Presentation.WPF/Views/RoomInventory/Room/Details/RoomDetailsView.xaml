<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.RoomInventory.Room.Details.RoomDetailsView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:details="clr-namespace:Innova.Presentation.Core.RoomInventory.Room.Details;assembly=Innova.Presentation.Core"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  d:DataContext="{d:DesignInstance Type=details:RoomDetailsViewModel,
                                                   IsDesignTimeCreatable=True}"
                  d:DesignHeight="auto"
                  d:DesignWidth="auto"
                  mc:Ignorable="d">

    <Grid Width="620" Background="{StaticResource Surface3Brush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0" Margin="24,20,24,4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Style="{StaticResource TextHeading}" Text="{Binding RoomNumber}" />

                    <Border Margin="10,2,0,0" VerticalAlignment="Center">

                        <Border.Style>
                            <Style BasedOn="{StaticResource BadgeDefault}" TargetType="Border">

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding StatusBadge}" Value="Success">
                                        <Setter Property="Background" Value="{StaticResource StatusSuccessFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding StatusBadge}" Value="Warning">
                                        <Setter Property="Background" Value="{StaticResource StatusWarningFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorderBrush}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding StatusBadge}" Value="Danger">
                                        <Setter Property="Background" Value="{StaticResource StatusDangerFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusDangerBorderBrush}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding StatusBadge}" Value="Neutral">
                                        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="Medium"
                                   Text="{Binding StatusLabel}">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding StatusBadge}" Value="Success">
                                            <Setter Property="Foreground" Value="{StaticResource StatusSuccessTextBrush}" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding StatusBadge}" Value="Warning">
                                            <Setter Property="Foreground" Value="{StaticResource StatusWarningTextBrush}" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding StatusBadge}" Value="Danger">
                                            <Setter Property="Foreground" Value="{StaticResource StatusDangerTextBrush}" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding StatusBadge}" Value="Neutral">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>
                    </Border>
                </StackPanel>

                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource TextBodySecondary}"
                           Text="{Binding RoomTypeName}" />

            </StackPanel>

            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource ButtonIcon}">

                <Path Width="14"
                      Height="14"
                      Data="{StaticResource IconClose}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform" />

            </Button>

        </Grid>

        <!--  Details  -->
        <ScrollViewer Grid.Row="1"
                      MaxHeight="580"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="24,8,24,16">

                <!--  Room Information  -->
                <TextBlock Margin="0,12,0,12"
                           Style="{StaticResource TextSubtitle}"
                           Text="Room Information" />

                <TextBlock Style="{StaticResource TextLabel}" Text="Room Number" />

                <TextBlock Margin="0,2,0,12"
                           Style="{StaticResource TextBody}"
                           Text="{Binding RoomNumber}" />

                <TextBlock Style="{StaticResource TextLabel}" Text="Room Type" />

                <Grid Margin="0,4,0,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Style="{StaticResource TextBody}"
                               Text="{Binding RoomTypeName}" />

                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            Command="{Binding OpenRoomTypeCommand}"
                            Content="View Room Type"
                            Style="{StaticResource ButtonSecondary}" />

                </Grid>

                <!--  Location  -->
                <TextBlock Margin="0,20,0,12"
                           Style="{StaticResource TextSubtitle}"
                           Text="Location" />

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">

                        <TextBlock Style="{StaticResource TextLabel}" Text="Floor" />

                        <TextBlock Margin="0,2,0,10"
                                   Style="{StaticResource TextBody}"
                                   Text="{Binding FloorLevel}" />

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <TextBlock Style="{StaticResource TextLabel}" Text="Wing" />

                        <TextBlock Margin="0,2,0,10"
                                   Style="{StaticResource TextBody}"
                                   Text="{Binding FloorWing, TargetNullValue=Not specified, FallbackValue=Not specified}" />

                    </StackPanel>

                </Grid>

                <!--  Room Status and Service Actions  -->
                <TextBlock Margin="0,20,0,12"
                           Style="{StaticResource TextSubtitle}"
                           Text="Room Status" />

                <TextBlock Style="{StaticResource TextLabel}" Text="Current Status" />

                <TextBlock Margin="0,2,0,12"
                           Style="{StaticResource TextBody}"
                           Text="{Binding StatusLabel}" />

                <StackPanel Orientation="Horizontal">

                    <Button Margin="0,0,10,0"
                            Command="{Binding ReturnRoomToServiceCommand}"
                            Content="Return to Service"
                            IsEnabled="{Binding CanReturnToService}"
                            Style="{StaticResource ButtonSuccess}" />

                    <Button Command="{Binding TakeRoomOutOfServiceCommand}"
                            Content="Take Out of Service"
                            IsEnabled="{Binding CanMarkOutOfService}"
                            Style="{StaticResource ButtonDangerOutline}" />

                </StackPanel>

                <!--  Front Desk  -->
                <TextBlock Margin="0,24,0,12"
                           Style="{StaticResource TextSubtitle}"
                           Text="Front Desk" />

                <TextBlock Margin="0,0,0,10"
                           Style="{StaticResource TextBodySecondary}"
                           Text="View the stay currently associated with this room." />

                <Button HorizontalAlignment="Left"
                        Command="{Binding GetActiveStayCommand}"
                        Content="View Active Stay"
                        Style="{StaticResource ButtonSecondary}" />

                <!--  Housekeeping  -->
                <TextBlock Margin="0,24,0,12"
                           Style="{StaticResource TextSubtitle}"
                           Text="Housekeeping" />

                <TextBlock Margin="0,0,0,12"
                           Style="{StaticResource TextBodySecondary}"
                           Text="Schedule a housekeeping task for this room." />

                <StackPanel>

                    <Button HorizontalAlignment="Left"
                            Command="{Binding ShowTaskTypeCommand}"
                            Content="Select Task Type"
                            Style="{StaticResource ButtonSecondary}" />

                    <ComboBox Width="240"
                              Margin="0,12,0,0"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding TaskTypes}"
                              SelectedItem="{Binding SelectedType}">

                        <ComboBox.Style>
                            <Style BasedOn="{StaticResource ComboBoxDefault}" TargetType="ComboBox">

                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowTaskType}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </ComboBox.Style>

                    </ComboBox>

                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ScheduleHouseKeepingCommand}"
                            Content="Schedule Housekeeping"
                            Style="{StaticResource ButtonSuccess}" />

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

        <!--  Footer  -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,1,0,0">

            <Grid Margin="24,14,24,14">

                <Button HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}"
                        Content="Close"
                        Style="{StaticResource ButtonGhost}" />

            </Grid>

        </Border>

    </Grid>

</views:MvxWpfView>