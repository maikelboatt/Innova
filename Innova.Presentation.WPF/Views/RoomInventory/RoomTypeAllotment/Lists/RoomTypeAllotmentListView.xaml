<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.RoomInventory.RoomTypeAllotment.Lists.RoomTypeAllotmentListView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:lists="clr-namespace:Innova.Presentation.Core.RoomInventory.RoomTypeAllotment.Lists;assembly=Innova.Presentation.Core"
                  xmlns:loadingSpinnerControl="clr-namespace:LoadingSpinnerControl;assembly=LoadingSpinnerControl"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  d:DataContext="{d:DesignInstance Type=lists:RoomTypeAllotmentListViewModel,
                                                   IsDesignTimeCreatable=False}"
                  d:DesignHeight="600"
                  d:DesignWidth="1100"
                  mc:Ignorable="d">

    <views:MvxWpfView.Resources>

        <!--
            A calendar cell is a Button (not a Border + InputBinding): InputBindings are not in the
            visual tree, so they cannot reach the page's ViewModel with a FindAncestor binding,
            but a Button's Command can. The Badge value on the cell ViewModel selects the colours.
        -->
        <Style x:Key="AllotmentCellButton" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="Background" Value="{StaticResource StatusSuccessFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource StatusSuccessTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{Binding RemainingDisplay}" />
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Opacity="0.75"
                                           Text="{Binding TotalDisplay}"
                                           Visibility="{Binding ShowTotal, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Badge}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource StatusWarningFillBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource StatusWarningTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Badge}" Value="Danger">
                    <Setter Property="Background" Value="{StaticResource StatusDangerFillBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StatusDangerBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource StatusDangerTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Badge}" Value="None">
                    <Setter Property="Background" Value="{StaticResource StatusNeutralFillBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StatusNeutralBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource StatusNeutralTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Segmented "7 days / 14 days" toggle: ghost buttons, the active one is tinted  -->
        <Style x:Key="SegmentWeek"
               BasedOn="{StaticResource ButtonGhost}"
               TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWeekWindow}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBlue50Brush}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBlue600Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentFortnight"
               BasedOn="{StaticResource ButtonGhost}"
               TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFortnightWindow}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBlue50Brush}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBlue600Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Legend swatch  -->
        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </views:MvxWpfView.Resources>

    <Grid Background="{StaticResource Surface1Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Header: title + window navigation  -->
            <RowDefinition Height="Auto" />
            <!--  Toolbar: search, legend, refresh  -->
            <RowDefinition Height="*" />
            <!--  Calendar / empty state / loading  -->
        </Grid.RowDefinitions>

        <!--  ── Header ───────────────────────────────────────────  -->
        <Grid Grid.Row="0" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource TextHeading}"
                       Text="{Binding Title}" />

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                <Button MinHeight="32"
                        Margin="0,0,8,0"
                        Padding="12,4"
                        Command="{Binding TodayCommand}"
                        Content="Today"
                        Style="{StaticResource ButtonSecondary}" />

                <Button Command="{Binding PreviousWindowCommand}"
                        Style="{StaticResource ButtonIcon}"
                        ToolTip="Previous">
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource IconChevronLeft}"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Stretch="Uniform" />
                </Button>

                <TextBlock MinWidth="170"
                           Margin="4,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextSubtitle}"
                           Text="{Binding RangeDisplay}"
                           TextAlignment="Center" />

                <Button Command="{Binding NextWindowCommand}"
                        Style="{StaticResource ButtonIcon}"
                        ToolTip="Next">
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource IconChevronRight}"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Stretch="Uniform" />
                </Button>

                <Border Margin="16,0,0,0"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ShowWeekCommand}"
                                Content="7 days"
                                Style="{StaticResource SegmentWeek}" />
                        <Button Command="{Binding ShowFortnightCommand}"
                                Content="14 days"
                                Style="{StaticResource SegmentFortnight}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!--  ── Toolbar: search, legend, refresh ────────────────────  -->
        <Grid Grid.Row="1" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource TextBoxSearch}"
                     Tag="Search room types"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Legend: same thresholds as AllotmentCellViewModel  -->
            <StackPanel Grid.Column="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Background="{StaticResource StatusSuccessFillBrush}"
                        BorderBrush="{StaticResource StatusSuccessBorderBrush}"
                        Style="{StaticResource LegendSwatch}" />
                <TextBlock Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Text="Available" />

                <Border Background="{StaticResource StatusWarningFillBrush}"
                        BorderBrush="{StaticResource StatusWarningBorderBrush}"
                        Style="{StaticResource LegendSwatch}" />
                <TextBlock Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Text="Filling up (80%+)" />

                <Border Background="{StaticResource StatusDangerFillBrush}"
                        BorderBrush="{StaticResource StatusDangerBorderBrush}"
                        Style="{StaticResource LegendSwatch}" />
                <TextBlock Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Text="Full" />

                <Border Background="{StaticResource StatusNeutralFillBrush}"
                        BorderBrush="{StaticResource StatusNeutralBorderBrush}"
                        Style="{StaticResource LegendSwatch}" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Text="Not set up / closed" />
            </StackPanel>

            <Button Grid.Column="3"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource ButtonIcon}"
                    ToolTip="Refresh">
                <Path Width="18"
                      Height="18"
                      Data="{StaticResource IconRefresh}"
                      Fill="{StaticResource TextSecondaryBrush}"
                      Stretch="Uniform" />
            </Button>
        </Grid>

        <!--  ── Content: calendar card, empty state, loading overlay (z-order = declaration order) ──  -->
        <Grid Grid.Row="2" Margin="24,0,24,24">

            <!--  Calendar card  -->
            <Border Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  Day headers  -->
                        <RowDefinition Height="*" />
                        <!--  Room type rows  -->
                    </Grid.RowDefinitions>

                    <!--
                        Day header row. It sits outside the ScrollViewer so it stays put while rows scroll.
                        When the body shows a vertical scrollbar it is narrower than the header by the
                        scrollbar width, so the header gets a matching right margin (17 = default Windows
                        scrollbar width; change it if your ScrollBar style is a different width).
                    -->
                    <Border Grid.Row="0"
                            Background="{StaticResource NeutralGray50Brush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Padding" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=BodyScroll}" Value="Visible">
                                        <Setter Property="Padding" Value="0,0,17,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Margin="16,0"
                                       Padding="0,0,0,10"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource TextLabel}"
                                       Text="ROOM TYPE" />

                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="DayCell"
                                                Padding="0,8"
                                                Background="Transparent">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center"
                                                           Style="{StaticResource TextCaption}"
                                                           Text="{Binding MonthLabel}" />
                                                <TextBlock HorizontalAlignment="Center"
                                                           Style="{StaticResource TextCaption}"
                                                           Text="{Binding DayOfWeekLabel}" />
                                                <TextBlock x:Name="DayNumber"
                                                           HorizontalAlignment="Center"
                                                           Style="{StaticResource TextSubtitle}"
                                                           Text="{Binding DayNumber}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!--  Order matters: Today is declared last so it wins over Weekend  -->
                                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                <Setter TargetName="DayCell" Property="Background" Value="{StaticResource NeutralGray100Brush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="DayCell" Property="Background" Value="{StaticResource PrimaryBlue50Brush}" />
                                                <Setter TargetName="DayNumber" Property="Foreground" Value="{StaticResource PrimaryBlue600Brush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!--  Room type rows  -->
                    <ScrollViewer x:Name="BodyScroll"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid MinHeight="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Margin="16,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold"
                                                           Style="{StaticResource TextBody}"
                                                           Text="{Binding RoomTypeName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                                <!--  Visible only when some nights in the window have no allotment row  -->
                                                <TextBlock Foreground="{StaticResource TextWarningBrush}"
                                                           Style="{StaticResource TextCaption}"
                                                           Text="{Binding GapsDisplay}"
                                                           Visibility="{Binding HasGaps, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>

                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.OpenAllotmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource AllotmentCellButton}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  Empty state: no room types (or none match the search) and not loading  -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Path Width="48"
                      Height="48"
                      Margin="0,0,0,12"
                      HorizontalAlignment="Center"
                      Data="{StaticResource RoomAllotmentIcon}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform" />
                <TextBlock HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Style="{StaticResource TextBody}"
                           Text="No room types to show" />
                <TextBlock Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource TextBodySecondary}"
                           Text="Try a different search, or define a room type first." />
            </StackPanel>

            <!--  Loading overlay (single instance, on top)  -->
            <Border Background="{StaticResource Surface1Brush}"
                    Opacity="0.85"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                    <loadingSpinnerControl:LoadingSpinner Diameter="100"
                                                          IsLoading="{Binding IsLoading}"
                                                          Thickness="3" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource TextBodySecondary}"
                               Text="Loading allotments..." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</views:MvxWpfView>