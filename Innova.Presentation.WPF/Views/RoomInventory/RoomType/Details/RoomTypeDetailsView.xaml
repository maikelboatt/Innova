<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.RoomInventory.RoomType.Details.RoomTypeDetailsView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:details="clr-namespace:Innova.Presentation.Core.RoomInventory.RoomType.Details;assembly=Innova.Presentation.Core"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  d:DataContext="{d:DesignInstance Type=details:RoomTypeDetailsViewModel,
                                                   IsDesignTimeCreatable=True}"
                  d:DesignHeight="auto"
                  d:DesignWidth="auto"
                  mc:Ignorable="d">
    <Grid Width="520" Background="{StaticResource Surface3Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ── Header ───────────────────────────────────────────  -->
        <Grid Grid.Row="0" Margin="24,20,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextHeading}" Text="{Binding Name}" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource ButtonIcon}">
                <Path Width="14"
                      Height="14"
                      Data="{StaticResource IconClose}"
                      Fill="{StaticResource TextMutedBrush}"
                      Stretch="Uniform" />
            </Button>
        </Grid>

        <!--  ── Read-only body ───────────────────────────────────  -->
        <ScrollViewer Grid.Row="1"
                      MaxHeight="520"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,8">

                <TextBlock Style="{StaticResource TextLabel}" Text="Max Occupancy" />
                <TextBlock Margin="0,2,0,10"
                           Style="{StaticResource TextBody}"
                           Text="{Binding MaxOccupancy}" />

                <TextBlock Margin="0,20,0,8"
                           Style="{StaticResource TextSubtitle}"
                           Text="Rate" />
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBody}">
                        <Run Text="{Binding BaseRateAmount, Mode=OneWay}" />
                        <Run Text=" (" />
                        <Run Text="{Binding BaseRateCurrency, Mode=OneWay}" />
                        <Run Text=")" />
                    </TextBlock>
                </StackPanel>


            </StackPanel>
        </ScrollViewer>

        <!--  ── Footer actions ──────────────────────────────────────  -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,14,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding CloseCommand}"
                            Content="Close"
                            Style="{StaticResource ButtonGhost}" />
                    <Button Command="{Binding OpenRoomTypeEditCommand}"
                            Content="Update Room Type"
                            Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:MvxWpfView>