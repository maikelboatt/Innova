<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.Billing.Folio.Forms.OpenFolioView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:forms="clr-namespace:Innova.Presentation.Core.Billing.Folio.Forms;assembly=Innova.Presentation.Core"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  d:DataContext="{d:DesignInstance Type=forms:OpenFolioViewModel,
                                                   IsDesignTimeCreatable=False}"
                  d:DesignHeight="auto"
                  d:DesignWidth="auto"
                  mc:Ignorable="d">

    <views:MvxWpfView.Resources>

        <!--  Supporting text. Own style (not TextBodySecondary) so it uses the primary font.  -->
        <Style x:Key="HelpText"
               BasedOn="{StaticResource TextBody}"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <!--  "What is this folio for" card; the selected one gets a blue border and a tick  -->
        <Style x:Key="OptionCardButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Padding="14,12"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Margin="0,0,22,0"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource TextBody}"
                                               Text="{Binding Label}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource TextCaption}"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Path x:Name="Tick"
                                      Width="14"
                                      Height="14"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Data="{StaticResource IconConfirm}"
                                      Fill="{StaticResource PrimaryBlue600Brush}"
                                      Stretch="Uniform"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <!--  Declared after the hover trigger so a selected card keeps its blue border  -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource PrimaryBlue50Brush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBlue600Brush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  One row of the owner picker: name, detail, "already has an open folio" badge, tick when selected  -->
        <Style x:Key="OwnerRowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row"
                                Padding="12,8"
                                Background="Transparent"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="Medium"
                                               Style="{StaticResource TextBody}"
                                               Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Style="{StaticResource TextCaption}"
                                               Text="{Binding Detail}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <Border Padding="8,2"
                                            Background="{StaticResource StatusWarningFillBrush}"
                                            BorderBrush="{StaticResource StatusWarningBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Visibility="{Binding HasOpenFolios, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource StatusWarningTextBrush}"
                                                   Text="{Binding OpenFoliosDisplay}" />
                                    </Border>
                                    <Path x:Name="Tick"
                                          Width="14"
                                          Height="14"
                                          Margin="10,0,0,0"
                                          Data="{StaticResource IconConfirm}"
                                          Fill="{StaticResource PrimaryBlue600Brush}"
                                          Stretch="Uniform"
                                          Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource NeutralGray50Brush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource PrimaryBlue50Brush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </views:MvxWpfView.Resources>

    <Grid Width="560" Background="{StaticResource Surface3Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ── Header ───────────────────────────────────────────  -->
        <StackPanel Grid.Row="0" Margin="24,20,24,4">
            <TextBlock Style="{StaticResource TextHeading}" Text="Open Folio" />
            <TextBlock Margin="0,2,0,0"
                       Style="{StaticResource HelpText}"
                       Text="A folio collects the charges and payments of one stay, guest or group." />
        </StackPanel>

        <!--  ── Scrollable form body ────────────────────────────────  -->
        <ScrollViewer Grid.Row="1"
                      MaxHeight="560"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,8">

                <!--  1. What is the folio for  -->
                <TextBlock Margin="0,12,0,8"
                           Style="{StaticResource TextSubtitle}"
                           Text="What is it for?" />

                <ItemsControl ItemsSource="{Binding OwnerTypes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectOwnerTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource OptionCardButton}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  2. Which one  -->
                <TextBlock Margin="0,12,0,8"
                           Style="{StaticResource TextSubtitle}"
                           Text="{Binding OwnerPickerTitle}" />

                <TextBox Style="{StaticResource TextBoxSearch}"
                         Tag="Search"
                         Text="{Binding OwnerSearchText, UpdateSourceTrigger=PropertyChanged}" />

                <Border Margin="0,8,0,0"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid MinHeight="64">
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Owners}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectOwnerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OwnerRowButton}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource HelpText}"
                                   Text="Loading..."
                                   Visibility="{Binding IsLoadingOwners, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource HelpText}"
                                   Text="{Binding EmptyOwnersMessage}"
                                   Visibility="{Binding ShowEmptyOwners, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <!--  Non-blocking: the owner already has an open folio  -->
                <StackPanel Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding HasDuplicateWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Path Width="14"
                          Height="14"
                          Margin="0,2,8,0"
                          VerticalAlignment="Top"
                          Data="{StaticResource IconWarning}"
                          Fill="{StaticResource StatusWarningTextBrush}"
                          Stretch="Uniform" />
                    <TextBlock MaxWidth="480"
                               Foreground="{StaticResource StatusWarningTextBrush}"
                               Style="{StaticResource TextCaption}"
                               Text="{Binding DuplicateWarning}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!--  3. Currency  -->
                <TextBlock Margin="0,20,0,8"
                           Style="{StaticResource TextSubtitle}"
                           Text="Currency" />

                <StackPanel>
                    <TextBlock Margin="0,0,0,4"
                               Style="{StaticResource TextLabel}"
                               Text="Currency code" />
                    <TextBox Width="100"
                             HorizontalAlignment="Left"
                             CharacterCasing="Upper"
                             MaxLength="3"
                             Style="{StaticResource TextBoxDefault}"
                             Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding HasCurrencyWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Path Width="14"
                          Height="14"
                          Margin="0,2,8,0"
                          VerticalAlignment="Top"
                          Data="{StaticResource IconWarning}"
                          Fill="{StaticResource StatusWarningTextBrush}"
                          Stretch="Uniform" />
                    <TextBlock MaxWidth="480"
                               Foreground="{StaticResource StatusWarningTextBrush}"
                               Style="{StaticResource TextCaption}"
                               Text="{Binding CurrencyWarning}"
                               TextWrapping="Wrap" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!--  ── Footer actions ──────────────────────────────────────  -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,14,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextCaption}"
                           Text="{Binding ValidationMessage}"
                           Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            IsCancel="True"
                            Style="{StaticResource ButtonGhost}" />
                    <Button Command="{Binding SaveCommand}"
                            Content="Open Folio"
                            Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:MvxWpfView>