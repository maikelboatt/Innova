<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.Billing.Folio.Details.FolioDetailsView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:details="clr-namespace:Innova.Presentation.Core.Billing.Folio.Details;assembly=Innova.Presentation.Core"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  d:DataContext="{d:DesignInstance Type=details:FolioDetailsViewModel,
                                                   IsDesignTimeCreatable=False}"
                  d:DesignHeight="auto"
                  d:DesignWidth="auto"
                  mc:Ignorable="d">

    <views:MvxWpfView.Resources>

        <!--  Supporting text. Own style (not TextBodySecondary) so it uses the primary font.  -->
        <Style x:Key="HelpText"
               BasedOn="{StaticResource TextBody}"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <!--  Small stat card (Charges, Paid / credited)  -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!--  Compact action buttons in the action bar  -->
        <Style x:Key="ActionSecondary"
               BasedOn="{StaticResource ButtonSecondary}"
               TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
        </Style>

        <!--  Selectable chip (payment method, adjustment type): the selected one is tinted  -->
        <Style x:Key="ChoiceChip" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip"
                                Padding="12,5"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <TextBlock x:Name="ChipText"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeLabel}"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding Label}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource PrimaryBlue50Brush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryBlue600Brush}" />
                                <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource PrimaryBlue600Brush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  One-tap suggestion (charge categories): same look, no selected state  -->
        <Style x:Key="SuggestionChip" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip"
                                Padding="12,5"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <TextBlock FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeLabel}"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryBlue600Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </views:MvxWpfView.Resources>

    <Grid Width="600" Background="{StaticResource Surface3Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ── Header: who the folio is for + status ─────────────────  -->
        <Grid Grid.Row="0" Margin="24,20,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource TextHeading}" Text="{Binding Summary.OwnerName}" />
                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource HelpText}" Text="{Binding Summary.OwnerTypeLabel}" />
                    <TextBlock Style="{StaticResource HelpText}" Text=" · " />
                    <TextBlock Style="{StaticResource HelpText}" Text="{Binding Summary.OwnerDetail}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
                <Border.Style>
                    <Style BasedOn="{StaticResource BadgeDefault}" TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Summary.StatusBadge}" Value="Info">
                                <Setter Property="Background" Value="{StaticResource StatusActiveFillBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource StatusActiveBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Summary.StatusBadge}" Value="Success">
                                <Setter Property="Background" Value="{StaticResource StatusSuccessFillBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Summary.StatusBadge}" Value="None">
                                <Setter Property="Background" Value="{StaticResource StatusNeutralFillBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource StatusNeutralBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="Medium"
                           Text="{Binding Summary.StatusLabel}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Summary.StatusBadge}" Value="Info">
                                    <Setter Property="Foreground" Value="{StaticResource StatusActiveTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Summary.StatusBadge}" Value="Success">
                                    <Setter Property="Foreground" Value="{StaticResource StatusSuccessTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Summary.StatusBadge}" Value="None">
                                    <Setter Property="Foreground" Value="{StaticResource StatusNeutralTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>

        <!--  ── Scrollable body ───────────────────────────────────  -->
        <ScrollViewer Grid.Row="1"
                      MaxHeight="560"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,8">

                <!--  Balance + totals  -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Balance: red = owes, amber = overpaid, green = nothing owed, grey = void  -->
                    <Border Grid.Column="0"
                            Padding="16,12"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource StatusNeutralFillBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource StatusNeutralBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Summary.BalanceBadge}" Value="Danger">
                                        <Setter Property="Background" Value="{StaticResource StatusDangerFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusDangerBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Summary.BalanceBadge}" Value="Warning">
                                        <Setter Property="Background" Value="{StaticResource StatusWarningFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Summary.BalanceBadge}" Value="Success">
                                        <Setter Property="Background" Value="{StaticResource StatusSuccessFillBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding BalanceCaption}" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding Summary.BalanceDisplay}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource TextTitle}" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource StatusNeutralTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Summary.BalanceBadge}" Value="Danger">
                                                <Setter Property="Foreground" Value="{StaticResource StatusDangerTextBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Summary.BalanceBadge}" Value="Warning">
                                                <Setter Property="Foreground" Value="{StaticResource StatusWarningTextBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Summary.BalanceBadge}" Value="Success">
                                                <Setter Property="Foreground" Value="{StaticResource StatusSuccessTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextCaption}" Text="Charges" />
                            <TextBlock Margin="0,2,0,0"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource TextBody}"
                                       Text="{Binding Summary.ChargesDisplay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextCaption}" Text="Paid / credited" />
                            <TextBlock Margin="0,2,0,0"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource TextBody}"
                                       Text="{Binding Summary.PaidDisplay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Action bar: entries on the left (open folios only), settle / void on the right  -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Command="{Binding ShowChargeComposerCommand}"
                                Content="+ Charge"
                                IsEnabled="{Binding IsOpen}"
                                Style="{StaticResource ActionSecondary}" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding ShowPaymentComposerCommand}"
                                Content="+ Payment"
                                IsEnabled="{Binding IsOpen}"
                                Style="{StaticResource ActionSecondary}" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding ShowAdjustmentComposerCommand}"
                                Content="+ Credit"
                                IsEnabled="{Binding IsOpen}"
                                Style="{StaticResource ActionSecondary}" />
                        <Button Command="{Binding ShowRefundComposerCommand}"
                                Content="+ Refund"
                                IsEnabled="{Binding CanRefund}"
                                Style="{StaticResource ActionSecondary}"
                                ToolTip="{Binding RefundHint}"
                                ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button MinWidth="0"
                                MinHeight="32"
                                Margin="0,0,8,0"
                                Padding="12,4"
                                Command="{Binding SettleCommand}"
                                Content="Settle"
                                Style="{StaticResource ButtonSuccess}"
                                ToolTip="{Binding SettleHint}"
                                ToolTipService.ShowOnDisabled="True" />
                        <Button MinWidth="0"
                                MinHeight="32"
                                Padding="12,4"
                                Command="{Binding VoidCommand}"
                                Content="Void"
                                Style="{StaticResource ButtonDangerOutline}" />
                    </StackPanel>
                </Grid>

                <!--  ── Inline entry panel (one of three) ─────────────  -->
                <Border Margin="0,12,0,0"
                        Padding="16,14"
                        Background="{StaticResource NeutralGray50Brush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding IsComposerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>

                        <!--  Charge  -->
                        <StackPanel Visibility="{Binding IsChargeComposerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource TextSubtitle}" Text="Post a charge" />

                            <TextBlock Margin="0,10,0,6"
                                       Style="{StaticResource TextLabel}"
                                       Text="Category" />
                            <ItemsControl ItemsSource="{Binding ChargeComposer.CategorySuggestions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SuggestionChip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding ChargeComposer.Category, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,0,0,4"
                                               Style="{StaticResource TextLabel}"
                                               Text="Amount" />
                                    <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding ChargeComposer.AmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,4"
                                               Style="{StaticResource TextLabel}"
                                               Text="Description (optional)" />
                                    <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding ChargeComposer.Description, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource TextError}"
                                       Text="{Binding ChargeComposer.AmountError}"
                                       Visibility="{Binding ChargeComposer.HasAmountError, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Margin="0,14,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding CloseComposerCommand}"
                                        Content="Cancel"
                                        Style="{StaticResource ButtonGhost}" />
                                <Button Command="{Binding SubmitChargeCommand}"
                                        Content="Post charge"
                                        Style="{StaticResource ButtonPrimary}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Payment  -->
                        <StackPanel Visibility="{Binding IsPaymentComposerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource TextSubtitle}" Text="Record a payment" />

                            <TextBlock Margin="0,10,0,6"
                                       Style="{StaticResource TextLabel}"
                                       Text="Method" />
                            <ItemsControl ItemsSource="{Binding PaymentComposer.Methods}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ChoiceChip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,0,0,4"
                                               Style="{StaticResource TextLabel}"
                                               Text="Amount" />
                                    <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding PaymentComposer.AmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,4"
                                               Style="{StaticResource TextLabel}"
                                               Text="Reference (optional)" />
                                    <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding PaymentComposer.Reference, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource TextError}"
                                       Text="{Binding PaymentComposer.AmountError}"
                                       Visibility="{Binding PaymentComposer.HasAmountError, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Margin="0,8,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding PaymentComposer.HasOverpaymentWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Path Width="14"
                                      Height="14"
                                      Margin="0,2,8,0"
                                      VerticalAlignment="Top"
                                      Data="{StaticResource IconWarning}"
                                      Fill="{StaticResource StatusWarningTextBrush}"
                                      Stretch="Uniform" />
                                <TextBlock MaxWidth="480"
                                           Foreground="{StaticResource StatusWarningTextBrush}"
                                           Style="{StaticResource TextCaption}"
                                           Text="{Binding PaymentComposer.OverpaymentWarning}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding CloseComposerCommand}"
                                        Content="Cancel"
                                        Style="{StaticResource ButtonGhost}" />
                                <Button Command="{Binding SubmitPaymentCommand}"
                                        Content="Record payment"
                                        Style="{StaticResource ButtonPrimary}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Credit (goodwill credit / billing correction)  -->
                        <StackPanel Visibility="{Binding IsAdjustmentComposerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource TextSubtitle}" Text="Post a credit" />

                            <TextBlock Margin="0,10,0,6"
                                       Style="{StaticResource TextLabel}"
                                       Text="Type" />
                            <ItemsControl ItemsSource="{Binding AdjustmentComposer.Types}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectAdjustmentTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ChoiceChip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,0,0,4"
                                       Style="{StaticResource TextCaption}"
                                       Text="{Binding AdjustmentComposer.TypeHint}" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,0,0,4"
                                               Style="{StaticResource TextLabel}"
                                               Text="Amount" />
                                    <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding AdjustmentComposer.AmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,4"
                                               Style="{StaticResource TextLabel}"
                                               Text="Reason" />
                                    <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding AdjustmentComposer.Reason, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource TextError}"
                                       Text="{Binding AdjustmentComposer.AmountError}"
                                       Visibility="{Binding AdjustmentComposer.HasAmountError, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Margin="0,14,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding CloseComposerCommand}"
                                        Content="Cancel"
                                        Style="{StaticResource ButtonGhost}" />
                                <Button Command="{Binding SubmitAdjustmentCommand}"
                                        Content="Post credit"
                                        Style="{StaticResource ButtonPrimary}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Refund (money going back to the guest)  -->
                        <StackPanel Visibility="{Binding IsRefundComposerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource TextSubtitle}" Text="Refund to the guest" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource TextCaption}"
                                       Text="{Binding RefundHint}" />

                            <TextBlock Margin="0,10,0,6"
                                       Style="{StaticResource TextLabel}"
                                       Text="Returned by" />
                            <ItemsControl ItemsSource="{Binding RefundComposer.Methods}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectRefundMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ChoiceChip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,0,0,4"
                                               Style="{StaticResource TextLabel}"
                                               Text="Amount" />
                                    <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding RefundComposer.AmountText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,4"
                                               Style="{StaticResource TextLabel}"
                                               Text="Reference (optional)" />
                                    <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding RefundComposer.Reference, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Margin="0,0,0,4"
                                           Style="{StaticResource TextLabel}"
                                           Text="Reason" />
                                <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding RefundComposer.Reason, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource TextError}"
                                       Text="{Binding RefundComposer.AmountError}"
                                       Visibility="{Binding RefundComposer.HasAmountError, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Margin="0,14,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding CloseComposerCommand}"
                                        Content="Cancel"
                                        Style="{StaticResource ButtonGhost}" />
                                <Button Command="{Binding SubmitRefundCommand}"
                                        Content="Issue refund"
                                        Style="{StaticResource ButtonPrimary}" />
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </Border>

                <!--  ── Activity (the statement) ───────────────────────  -->
                <TextBlock Margin="0,20,0,8"
                           Style="{StaticResource TextSubtitle}"
                           Text="Activity" />

                <Border Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid MinHeight="64">
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,10"
                                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Margin="0,0,8,0"
                                                                Padding="7,1"
                                                                VerticalAlignment="Center"
                                                                BorderThickness="1"
                                                                CornerRadius="8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource StatusNeutralFillBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource StatusNeutralBorderBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding KindBadge}" Value="Success">
                                                                            <Setter Property="Background" Value="{StaticResource StatusSuccessFillBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding KindBadge}" Value="Warning">
                                                                            <Setter Property="Background" Value="{StaticResource StatusWarningFillBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorderBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding KindBadge}" Value="Info">
                                                                            <Setter Property="Background" Value="{StaticResource StatusActiveFillBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource StatusActiveBorderBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="{StaticResource FontSizeCaption}" Text="{Binding KindLabel}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource StatusNeutralTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding KindBadge}" Value="Success">
                                                                                <Setter Property="Foreground" Value="{StaticResource StatusSuccessTextBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding KindBadge}" Value="Warning">
                                                                                <Setter Property="Foreground" Value="{StaticResource StatusWarningTextBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding KindBadge}" Value="Info">
                                                                                <Setter Property="Foreground" Value="{StaticResource StatusActiveTextBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock FontWeight="Medium"
                                                                   Style="{StaticResource TextBody}"
                                                                   Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource TextCaption}"
                                                               Text="{Binding Detail}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Right"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding AmountDisplay}">
                                                        <TextBlock.Style>
                                                            <Style BasedOn="{StaticResource TextBody}" TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource StatusSuccessTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Style="{StaticResource TextCaption}"
                                                               Text="{Binding OccurredDisplay}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource HelpText}"
                                   Text="Nothing has been posted to this folio yet."
                                   Visibility="{Binding ShowEmptyLedger, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  ── Footer ───────────────────────────────────────────  -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Margin="24,14,24,14"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Command="{Binding CloseCommand}"
                        Content="Close"
                        IsCancel="True"
                        Style="{StaticResource ButtonGhost}" />
            </StackPanel>
        </Border>
    </Grid>
</views:MvxWpfView>