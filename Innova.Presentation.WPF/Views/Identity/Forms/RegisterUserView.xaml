<views:MvxWpfView x:Class="Innova.Presentation.WPF.Views.Identity.Forms.RegisterUserView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:forms="clr-namespace:Innova.Presentation.Core.Identity.Forms;assembly=Innova.Presentation.Core"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
                  d:DataContext="{d:DesignInstance Type=forms:RegisterUserViewModel,
                                                   IsDesignTimeCreatable=True}"
                  d:DesignWidth="400"
                  mc:Ignorable="d">
    <Grid Width="400" Background="{StaticResource Surface3Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="24,20,24,16"
                   Style="{StaticResource TextHeading}"
                   Text="Add User" />

        <StackPanel Grid.Row="1" Margin="24,0,24,8">
            <TextBlock Margin="0,0,0,4"
                       Style="{StaticResource TextLabel}"
                       Text="Username" />
            <TextBox Style="{StaticResource TextBoxDefault}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,12,0,4"
                       Style="{StaticResource TextLabel}"
                       Text="Password" />
            <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordBoxDefault}" />

            <TextBlock Margin="0,12,0,4"
                       Style="{StaticResource TextLabel}"
                       Text="Role" />
            <ComboBox DisplayMemberPath="Value"
                      ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      Style="{StaticResource ComboBoxDefault}" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="24,20,24,20"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    Style="{StaticResource ButtonGhost}" />
            <Button Command="{Binding SaveCommand}"
                    Content="Create User"
                    Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </Grid>
</views:MvxWpfView>